# Pantry Raider boot screen (FoodAssistant-y8vj).
# Holds the panel from just after the root filesystem mounts until the kiosk
# switches to its own VT (the kiosk unit's chvt 7). A long oneshot that holds
# nothing up: DefaultDependencies=no keeps sysinit.target from waiting on it,
# and the only unit ordered after it is getty@tty1 (see
# boot-splash/getty-tty1.conf), so its terminal reset never lands on the
# animation. Fail-safe: the script waits up to 15 s for /dev/fb0, skips itself
# when anything is missing or tty1 is not on screen, gives up by itself after
# 300 s, and always exits 0.

[Unit]
Description=Pantry Raider boot screen
DefaultDependencies=no
After=systemd-udev-trigger.service local-fs.target
Conflicts=shutdown.target
Before=shutdown.target
ConditionPathExists=/opt/foodassistant/boot-splash/splash-art.gz
ConditionPathExists=/usr/local/bin/foodassistant-boot-splash
# The opt-in Plymouth theme owns the boot display when "splash" is on the
# kernel cmdline; stay out of its way.
ConditionKernelCommandLine=!splash

[Service]
Type=oneshot
ExecStart=/usr/local/bin/foodassistant-boot-splash
# Above the script's own 300 s give-up, so systemd never kills it first.
TimeoutStartSec=330
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
