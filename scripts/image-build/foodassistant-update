#!/usr/bin/env bash
# Pantry Raider over-the-air update helper (every Pi and install.sh server).
# ======================================================================
# Picks the update target for this device's channel, verifies it with the
# Pantry Raider release key, exports the verified commit to a staging
# directory, and (re)deploys the running copies from that export: the web app
# under APP_DIR (or the app image on a Docker install), the Stream Deck
# controller package under SD_DST, the host helpers, and the venv
# dependencies when requirements.txt changed. Finally it restarts whichever
# services it actually refreshed.
#
# It is invoked by the host bridge (POST /update, no arguments), which runs as
# root, so it can write under /opt and restart systemd units. It prints a
# short human log to stdout and, as its LAST line, a single JSON object the
# bridge parses and relays to the web UI. Every exit path emits that JSON line.
#
# Design notes:
#   - Nothing is installed that the release key did not sign. The stable
#     channel takes the newest signed release tag, the main channel the
#     signed tip of main. Verification reads raw git objects and checks them
#     with ssh-keygen -Y verify (git verify-tag needs a newer git than
#     Raspberry Pi OS bullseye ships). Every refusal keeps the running
#     version and says why.
#   - Every host-side install reads the staged export of the verified commit
#     (STAGE_ROOT/current), never the git checkout, so a file someone drops
#     into the checkout is never installed.
#   - The deploy is idempotent and re-runnable: an equal version redeploys.
#     A lower version holds unless it is the pinned one.
#   - Dependency installs are gated on a content hash of requirements.txt vs
#     the deployed copy, so an unchanged tree skips the slow Pi pip step.
#   - Recovery from a root shell only: sudo foodassistant-update
#     --allow-unsigned-once installs one release without the signature check.
#
# Layout on a Pi Remote device (see firstboot.sh deploy_remote_service and
# install_streamdeck):
#   REPO_DIR   - git checkout that is the update source (fetched here)
#   APP_DIR    - deployed app copy the web service runs from
#   VENV_DIR   - Python venv holding the service + Stream Deck dependencies
#   SERVICE    - the web UI systemd unit to restart after an app refresh
#   SD_DST     - deployed Stream Deck package the deck service runs from
#   SD_SERVICE - the Stream Deck systemd unit to restart after a deck refresh
set -uo pipefail

# Candidate locations for the git checkout, in priority order. The first that
# is a git working tree wins. These mirror firstboot.sh's REPO_DIR default and
# the baked-image / curl-installer clone locations.
REPO_CANDIDATES="${REPO_DIR:-} /opt/foodassistant-src /home/foodassistant/FoodAssistant"
APP_DIR="${APP_DIR:-/opt/foodassistant/service}"
VENV_DIR="${VENV_DIR:-/opt/foodassistant/venv}"
SERVICE="${SERVICE:-foodassistant-remote.service}"
SD_DST="${SD_DST:-/opt/foodassistant/foodassistant_streamdeck}"
SD_SERVICE="${SD_SERVICE:-foodassistant-streamdeck.service}"
GD_DST="${GD_DST:-/opt/foodassistant/foodassistant_gadgets}"
GD_SERVICE="${GD_SERVICE:-foodassistant-gadgets.service}"
# The kiosk browser caches the loaded page, so after redeploying the app we
# restart it (when present) to reload fresh CSS/JS. Absent on headless installs.
KIOSK_SERVICE="${KIOSK_SERVICE:-foodassistant-kiosk.service}"
# Where the helper scripts are installed. Overridable so the update logic can be
# exercised in tests without root.
BIN_DIR="${BIN_DIR:-/usr/local/bin}"

# Release trust. Bump UPDATER_TRUST_GENERATION only when the verification
# rules change: an installed updater is never replaced by one with a lower
# generation, and updaters older than 0.21 carry no such line (generation 0).
UPDATER_TRUST_GENERATION=1
# Docker installs need the signed release record (release.json) for every
# release above this one; at or below it a missing record pulls by version.
MANIFEST_REQUIRED_AFTER='0.21.0'
# The installed release-key list (root-owned; written on the first verified
# update and changed only by a verified release).
TRUST_FILE="${TRUST_FILE:-/etc/foodassistant/trust/release-signers}"
# What this device last installed: highest_version is the freshness floor.
STATE_FILE="${STATE_FILE:-/var/lib/foodassistant/update-state.json}"
# Verified exports live here, one directory per release, plus a current link.
STAGE_ROOT="${STAGE_ROOT:-/var/lib/foodassistant/releases}"
STAGE_MIN_MB="${FA_STAGE_MIN_MB:-200}"
# Where each release's signed record (release.json and release.json.sig) is.
RELEASE_BASE_URL="${RELEASE_BASE_URL:-https://github.com/Syracuse3DPrintingOrg/PantryRaider/releases/download}"
# Test hooks: a signers file that replaces the embedded list, and the running
# app version (normally read from the app itself).
FA_BOOTSTRAP_SIGNERS="${FA_BOOTSTRAP_SIGNERS:-}"
FA_RUNNING_VERSION="${FA_RUNNING_VERSION:-}"
# The stack .env on a Docker install and the app settings (deployment mode).
INSTALL_DIR="${INSTALL_DIR:-/opt/foodassistant}"
SETTINGS_JSON="${SETTINGS_JSON:-$INSTALL_DIR/data/settings.json}"

# What started this run. The host bridge sets FA_UPDATE_TRIGGER=scheduled for
# the app's automatic update; anything else (the Update now button, the
# Stream Deck key, a root shell) is a manual run. A scheduled run leaves alone
# a version that already failed to start on this device (see the hold after
# the freshness check), so the app is not taken down every few hours trying it.
SCHEDULED=0
[ "${FA_UPDATE_TRIGGER:-}" = "scheduled" ] && SCHEDULED=1

# The only option. The bridge passes no arguments, so this escape is reached
# from a root shell alone.
ALLOW_UNSIGNED_ONCE=0
_bad_arg=""
ORIG_ARGS=("$@")
for _arg in "$@"; do
  case "$_arg" in
    --allow-unsigned-once) ALLOW_UNSIGNED_ONCE=1 ;;
    *) [ -n "$_bad_arg" ] || _bad_arg="$_arg" ;;
  esac
done

# The Pantry Raider release-key list this updater trusts when the device has
# none installed yet (the text of scripts/release-signers). One line per key.
IFS= read -r -d '' EMBEDDED_SIGNERS <<'SIGNERS' || true
pantryraider-release namespaces="git,pantryraider-release" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHPWzaAihzRx7Y9JlXotaZfO0drDTOT/lXxvoePF82rd
SIGNERS

# The release verifier, run as: python3 -c "$PYVERIFY" <subcommand> <args>.
IFS= read -r -d '' PYVERIFY <<'PYVERIFY' || true
# Release verifier for Pantry Raider updates, standard library only. The
# canonical copy lives in foodassistant-update; firstboot.sh and install.sh
# carry byte-identical copies. Every subcommand prints one JSON line
# {ok, reason, ...} and exits 0. inspect-tag and inspect-commit skip the
# signature and serve only sudo foodassistant-update --allow-unsigned-once.
import base64
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request

PRINCIPAL = "pantryraider-release"
IMAGE_NAME = "ghcr.io/syracuse3dprintingorg/pantryraider"
SIG_BEGIN = b"-----BEGIN SSH SIGNATURE-----"
KEY_TYPE = re.compile(r"^(ssh-ed25519|ssh-rsa|ecdsa-sha2-\S+|sk-\S+)$")
VERSION_LINE = re.compile(r"""^APP_VERSION\s*(?::\s*\w+\s*)?=\s*["']([0-9]+\.[0-9]+\.[0-9]+)["']""", re.M)
DIGEST = re.compile(r"^sha256:[0-9a-f]{64}$")
FETCH_LIMIT = 4 * 1024 * 1024


def done(ok, reason="", **extra):
    out = {"ok": ok, "reason": reason}
    out.update(extra)
    print(json.dumps(out, sort_keys=True))
    sys.exit(0)


def git(gitdir, *args):
    r = subprocess.run(["git", "-C", gitdir, *args], capture_output=True)
    if r.returncode != 0:
        return None
    return r.stdout


def ssh_verify(signers, namespace, payload, sig):
    with tempfile.TemporaryDirectory() as tmp:
        sigfile = os.path.join(tmp, "payload.sig")
        with open(sigfile, "wb") as fh:
            fh.write(sig)
        try:
            r = subprocess.run(
                ["ssh-keygen", "-Y", "verify", "-f", signers, "-I", PRINCIPAL,
                 "-n", namespace, "-s", sigfile],
                input=payload, capture_output=True, timeout=60)
        except (OSError, subprocess.SubprocessError):
            return False
    return r.returncode == 0


def parse_version(text):
    m = VERSION_LINE.search(text)
    return m.group(1) if m else ""


def tree_version(gitdir, commit):
    raw = git(gitdir, "show", commit + ":service/app/config.py")
    if raw is None:
        return ""
    return parse_version(raw.decode("utf-8", "replace"))


def vtuple(value):
    v = value.strip()
    if v.startswith("v"):
        v = v[1:]
    parts = v.split(".")
    if len(parts) != 3 or not all(p.isdigit() for p in parts):
        return None
    return tuple(int(p) for p in parts)


def headers(raw):
    head = raw.split(b"\n\n", 1)[0]
    out = {}
    for line in head.split(b"\n"):
        if line.startswith(b" ") or b" " not in line:
            continue
        key, _, value = line.partition(b" ")
        out.setdefault(key.decode("utf-8", "replace"), value.decode("utf-8", "replace"))
    return out


def verify_tag(gitdir, tag, signers=None):
    ref = "refs/tags/" + tag
    kind = git(gitdir, "cat-file", "-t", ref)
    if kind is None:
        done(False, "missing", tag=tag)
    kind = kind.strip()
    if kind == b"commit" and signers is None:
        commit = git(gitdir, "rev-parse", ref).decode().strip()
        version = tree_version(gitdir, commit)
        if not version or "v" + version != tag:
            done(False, "version_mismatch", tag=tag, commit=commit, version=version)
        done(True, "", tag=tag, commit=commit, version=version)
    if kind != b"tag":
        done(False, "not_annotated", tag=tag)
    raw = git(gitdir, "cat-file", "tag", ref)
    if raw is None:
        done(False, "missing", tag=tag)
    lines = raw.splitlines(keepends=True)
    begin = -1
    for i, line in enumerate(lines):
        if line.rstrip(b"\n") == SIG_BEGIN:
            begin = i
    if begin < 0:
        if signers is not None:
            done(False, "unsigned", tag=tag)
        begin = len(lines)
    payload = b"".join(lines[:begin])
    if payload and not payload.endswith(b"\n"):
        payload += b"\n"
    if signers is not None:
        sig = b"".join(lines[begin:])
        if not sig.endswith(b"\n"):
            sig += b"\n"
        if not ssh_verify(signers, "git", payload, sig):
            done(False, "bad_signature", tag=tag)
    head = headers(payload)
    if head.get("tag", "") != tag:
        done(False, "name_mismatch", tag=tag)
    if head.get("type", "") != "commit":
        done(False, "not_commit", tag=tag)
    commit = head.get("object", "")
    version = tree_version(gitdir, commit)
    if not version or "v" + version != tag:
        done(False, "version_mismatch", tag=tag, commit=commit, version=version)
    done(True, "", tag=tag, commit=commit, version=version)


def verify_commit(gitdir, rev, signers=None):
    full = git(gitdir, "rev-parse", "--verify", "-q", rev + "^{commit}")
    if full is None:
        done(False, "missing")
    commit = full.decode().strip()
    if signers is not None:
        raw = git(gitdir, "cat-file", "commit", commit)
        if raw is None:
            done(False, "missing", commit=commit)
        head, sep, body = raw.partition(b"\n\n")
        kept = []
        sig = []
        in_sig = False
        for line in head.split(b"\n"):
            if in_sig and line.startswith(b" "):
                sig.append(line[1:])
                continue
            in_sig = False
            if line.startswith(b"gpgsig "):
                in_sig = True
                sig.append(line[len(b"gpgsig "):])
                continue
            kept.append(line)
        if not sig:
            done(False, "unsigned", commit=commit)
        payload = b"\n".join(kept) + sep + body
        if not ssh_verify(signers, "git", payload, b"\n".join(sig) + b"\n"):
            done(False, "bad_signature", commit=commit)
    version = tree_version(gitdir, commit)
    if not version:
        done(signers is None, "no_version", commit=commit, version="")
    done(True, "", commit=commit, version=version)


def verify_file(path, sigfile, signers, namespace):
    try:
        with open(path, "rb") as fh:
            payload = fh.read()
        with open(sigfile, "rb") as fh:
            sig = fh.read()
    except OSError:
        done(False, "missing")
    if not ssh_verify(signers, namespace, payload, sig):
        done(False, "bad_signature")
    done(True, "")


def fingerprints(signers):
    try:
        with open(signers, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        done(False, "missing")
    found = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        tokens = line.split()
        for i, tok in enumerate(tokens[:-1]):
            if KEY_TYPE.match(tok):
                try:
                    blob = base64.b64decode(tokens[i + 1], validate=True)
                except ValueError:
                    break
                digest = base64.b64encode(hashlib.sha256(blob).digest()).decode()
                found.append("SHA256:" + digest.rstrip("="))
                break
    if not found:
        done(False, "no_keys")
    done(True, "", fingerprints=",".join(found))


def vcmp(a, b):
    ta, tb = vtuple(a), vtuple(b)
    if ta is None or tb is None:
        done(False, "bad_version")
    done(True, "", result=(ta > tb) - (ta < tb))


def fetch(url, dest):
    try:
        with urllib.request.urlopen(url, timeout=20) as resp:
            data = resp.read(FETCH_LIMIT + 1)
    except urllib.error.HTTPError as exc:
        done(False, "missing" if exc.code == 404 else "http_" + str(exc.code))
    except (urllib.error.URLError, OSError, ValueError) as exc:
        if isinstance(getattr(exc, "reason", None), FileNotFoundError):
            done(False, "missing")
        if isinstance(exc, FileNotFoundError):
            done(False, "missing")
        done(False, "unreachable")
    if len(data) > FETCH_LIMIT:
        done(False, "too_large")
    tmp = dest + ".part"
    try:
        with open(tmp, "wb") as fh:
            fh.write(data)
        os.replace(tmp, dest)
    except OSError:
        done(False, "write_failed")
    done(True, "", bytes=len(data))


def check_manifest(path, version, commit):
    try:
        with open(path, encoding="utf-8") as fh:
            doc = json.load(fh)
    except (OSError, ValueError):
        done(False, "unreadable")
    if not isinstance(doc, dict):
        done(False, "unreadable")
    image = doc.get("image")
    if not isinstance(image, dict):
        image = {}
    if doc.get("format") != 1:
        done(False, "format")
    if doc.get("version") != version:
        done(False, "version")
    if doc.get("tag") != "v" + version:
        done(False, "tag")
    if doc.get("commit") != commit:
        done(False, "commit")
    if image.get("name") != IMAGE_NAME:
        done(False, "image_name")
    digest = image.get("index_digest")
    if not isinstance(digest, str) or not DIGEST.match(digest):
        done(False, "digest")
    done(True, "", digest=digest)


def main(argv):
    cmds = {
        "verify-tag": (verify_tag, 3),
        "verify-commit": (verify_commit, 3),
        "verify-file": (verify_file, 4),
        "fingerprints": (fingerprints, 1),
        "vcmp": (vcmp, 2),
        "fetch": (fetch, 2),
        "check-manifest": (check_manifest, 3),
        "inspect-tag": (verify_tag, 2),
        "inspect-commit": (verify_commit, 2),
    }
    if not argv or argv[0] not in cmds or len(argv) - 1 != cmds[argv[0]][1]:
        done(False, "usage")
    func = cmds[argv[0]][0]
    func(*argv[1:])


main(sys.argv[1:])
PYVERIFY

# The Wi-Fi fallback AP watchdog is the one helper that runs from sbin: its
# systemd unit was written at firstboot pointing at /usr/local/sbin, so the
# copy there is the one that actually executes.
SBIN_DIR="${SBIN_DIR:-/usr/local/sbin}"
# Update channel (FoodAssistant-wkwx): "stable" (the default) installs the
# newest signed release tag, "main" follows the signed tip of the main branch
# (bench and test devices). The app persists the choice to CHANNEL_FILE
# through the host bridge (POST /update/channel); UPDATE_CHANNEL overrides it
# for tests and manual runs. A missing, empty, or unknown value means stable.
CHANNEL_FILE="${CHANNEL_FILE:-/etc/foodassistant/update-channel}"
# On a Docker install the stable channel also pins the app image: the
# published image carries a tag per release (see
# .github/workflows/publish-image.yml), so FOODASSISTANT_TAG in the stack .env
# is set to the release version, pinned to its digest when the signed release
# record names one. The value it replaced is kept in PIN_STATE_FILE so
# switching back to main restores it.
PIN_STATE_FILE="${PIN_STATE_FILE:-/etc/foodassistant/update-tag-restore}"
# Hold this device on one specific release: write that version (0.18.9, or
# v0.18.9) into PINNED_VERSION_FILE and the stable channel targets it instead
# of the newest release, so an update never carries the device past a version
# that is known to work here. Delete the file to follow releases again. An
# empty or missing file is the normal case and changes nothing.
PINNED_VERSION_FILE="${PINNED_VERSION_FILE:-/etc/foodassistant/pinned-version}"
ENV_FILE="${ENV_FILE:-$INSTALL_DIR/.env}"

# Plain stdout log lines (the bridge tails stdout for a human summary too).
log() { printf '%s\n' "$*"; }

# Flush pending filesystem writes to the SD card. Called at the two points where
# a power cut would otherwise be most damaging: after the new image is fully
# local (so the image store is durable before we tear the old container down)
# and after the container swap (so the new state is on the card, not just in the
# page cache). `sync` is a no-op-cheap barrier; failures are non-fatal.
_sync() { sync 2>/dev/null || true; }

# Write CONTENT to PATH atomically (temp file in the same dir, flush, rename),
# so a power cut never leaves a half-written config file. Falls back to a direct
# write if the temp file cannot be created.
_atomic_write() {
  local path="$1" content="$2" dir tmp
  dir="$(dirname "$path")"
  mkdir -p "$dir" 2>/dev/null || true
  tmp="$(mktemp "$dir/.$(basename "$path").XXXXXX" 2>/dev/null)" || {
    printf '%s' "$content" > "$path"; return $?
  }
  printf '%s' "$content" > "$tmp"
  sync "$tmp" 2>/dev/null || sync
  mv -f "$tmp" "$path"
  _sync
}

# The root-owned source checkout older devices may not have yet.
ROOT_SRC_DIR="${ROOT_SRC_DIR:-/opt/foodassistant-src}"

# Whether ROOT_SRC_DIR is a real checkout owned by root (ROOT_SRC_UID in the
# tests), writable by nobody else, and carries the Grocy start-up hook the
# stack mounts from it. Docker creates a missing bind-mount source as an empty
# root-owned folder, so the hook folder alone proves nothing: a real checkout
# also has its .git and the app's config.py.
_root_src_ok() {
  local d="$ROOT_SRC_DIR" mode
  [ -d "$d" ] && [ ! -L "$d" ] || return 1
  [ "$(stat -c %u "$d" 2>/dev/null)" = "${ROOT_SRC_UID:-0}" ] || return 1
  mode="$(stat -c %a "$d" 2>/dev/null)" || return 1
  [ -n "$mode" ] && [ $(( 8#$mode & 8#022 )) -eq 0 ] || return 1
  [ -d "$d/docker/grocy-init" ] || return 1
  [ -e "$d/.git" ] && [ -f "$d/service/app/config.py" ]
}

# An older device's stack .env can still say REPO_DIR=/home/..., and a plain
# 'docker compose up' then mounts the Grocy start-up hook (run as root in the
# Grocy container) from the desktop user's editable checkout. Point it at the
# root-owned source instead, but only when that source is really there.
_move_env_repo_dir_off_home() {
  local env_file="$1" cur body
  [ -f "$env_file" ] || return 0
  cur="$(grep -m1 '^REPO_DIR=' "$env_file" 2>/dev/null | cut -d= -f2- \
    | sed -e 's/^["'"'"']//' -e 's/["'"'"']$//')"
  case "$cur" in
    /home/*) ;;
    *) return 0 ;;
  esac
  if ! _root_src_ok; then
    log "REPO_DIR in $env_file points at $cur; no root-owned source at $ROOT_SRC_DIR yet, so it stays."
    return 0
  fi
  body="$(sed "s|^REPO_DIR=.*|REPO_DIR=$ROOT_SRC_DIR|" "$env_file")" || return 0
  if _atomic_write "$env_file" "$body
" 2>/dev/null; then
    log "REPO_DIR in $env_file now points at $ROOT_SRC_DIR (was $cur)."
  else
    log "WARN: could not move REPO_DIR in $env_file to $ROOT_SRC_DIR."
  fi
}

# Release-trust fields every result carries (see _result).
R_VERIFIED=0
R_TARGET=""
R_CHANNEL=""
R_TRUST_FP=""
R_HOLD=""

# Emit the final JSON result line and exit. A python one-liner does the JSON
# encoding so log text with quotes/newlines is escaped correctly (no
# hand-rolled JSON). The process exit code mirrors ok (0 on success). The
# service_synced / streamdeck_synced / deps_installed fields let the UI show
# exactly what changed; older callers that only read ok/error/before/after/
# restarted keep working since those keys are unchanged. verified, target,
# channel, trust_fingerprint and hold_reason describe the release check: a
# freshness hold is ok with a hold_reason, and a verification problem is not
# ok, with error equal to hold_reason so older apps show it.
_result() {
  local ok="$1" error="$2" before="$3" after="$4" restarted="$5" \
        service_synced="${6:-0}" streamdeck_synced="${7:-0}" deps="${8:-0}" \
        recovered="${9:-0}"
  [ -n "${RUN_TMP:-}" ] && rm -rf "$RUN_TMP" 2>/dev/null
  _schedule_bridge_restart
  # reboot_needed is a global rather than a positional: it is set by the
  # I2C retrofit below when the bus was just turned on in the boot config
  # (the bus only appears after a reboot), and every exit path reports it.
  OK="$ok" ERR="$error" BEFORE="$before" AFTER="$after" RESTARTED="$restarted" \
  SVC="$service_synced" SD="$streamdeck_synced" DEPS="$deps" REC="$recovered" \
  REBOOT="${reboot_needed:-0}" VERIFIED="$R_VERIFIED" TARGET="$R_TARGET" \
  CHANNEL="$R_CHANNEL" TRUST_FP="$R_TRUST_FP" HOLD="$R_HOLD" \
  python3 -c '
import json, os
print(json.dumps({
    "ok": os.environ["OK"] == "1",
    "error": os.environ.get("ERR", ""),
    "before": os.environ.get("BEFORE", ""),
    "after": os.environ.get("AFTER", ""),
    "restarted": os.environ.get("RESTARTED", "") == "1",
    "service_synced": os.environ.get("SVC", "") == "1",
    "streamdeck_synced": os.environ.get("SD", "") == "1",
    "deps_installed": os.environ.get("DEPS", "") == "1",
    "remote_recovered": os.environ.get("REC", "") == "1",
    "reboot_needed": os.environ.get("REBOOT", "") == "1",
    "verified": os.environ.get("VERIFIED", "") == "1",
    "target": os.environ.get("TARGET", ""),
    "channel": os.environ.get("CHANNEL", ""),
    "trust_fingerprint": os.environ.get("TRUST_FP", ""),
    "hold_reason": os.environ.get("HOLD", ""),
}))'
  if [ "$ok" = "1" ]; then exit 0; fi
  exit 1
}

# Restart the host bridge a few seconds after this run ends, when this run
# installed a new one. This script is the bridge's child, so an inline restart
# would kill it; the detached one runs outside the bridge's cgroup once our
# JSON result has gone back. Called from _result only, so the restart can
# never land while the app is still being swapped or checked.
BRIDGE_RESTART_PENDING=0
_schedule_bridge_restart() {
  [ "$BRIDGE_RESTART_PENDING" = "1" ] || return 0
  BRIDGE_RESTART_PENDING=0
  if command -v systemd-run >/dev/null 2>&1; then
    # The whole fallback list runs in the background with its output (and the
    # update lock) closed, so neither the caller reading our stdout nor the
    # next update is held up by the sleep.
    { systemd-run --on-active=5s --unit="fa-bridge-restart-$$" \
        systemctl restart foodassistant-host-bridge.service \
        || setsid bash -c 'sleep 5; systemctl restart foodassistant-host-bridge.service'; } \
      >/dev/null 2>&1 </dev/null 9>&- &
  else
    setsid bash -c 'sleep 5; systemctl restart foodassistant-host-bridge.service' >/dev/null 2>&1 </dev/null 9>&- &
  fi
}

# Restart a unit only if it is actually installed. Returns 0 when it restarted.
_restart_unit() {
  local unit="$1"
  if ! systemctl list-unit-files "$unit" >/dev/null 2>&1; then
    log "Unit $unit is not installed; skipping restart."
    return 1
  fi
  if systemctl restart "$unit"; then
    log "Restarted $unit"
    return 0
  fi
  log "WARN: failed to restart $unit"
  return 1
}

# A Docker image id cut to the usual 12 characters for the log (empty stays
# empty, so the caller can print its own placeholder).
_short_image_id() {
  local id="${1#sha256:}"
  printf '%s' "${id:0:12}"
}

if [ -n "$_bad_arg" ]; then
  _result 0 "Unknown option $_bad_arg. The only option is --allow-unsigned-once." "" "" 0
fi

# One run at a time. A scheduled update and an Update press can arrive
# together, and two runs would each prune the other's staged export and swap
# the app under each other. The lock is held on fd 9 for the whole run (a
# re-exec keeps the descriptor, so the new copy goes on holding it) and the
# kernel drops it when the run ends, however it ends. The second run steps
# aside with a hold instead of failing. Without flock or a writable lock path
# the run goes ahead unlocked, as every run did before.
UPDATE_LOCK_FILE="${UPDATE_LOCK_FILE:-/run/foodassistant-update.lock}"
if command -v flock >/dev/null 2>&1; then
  if [ "${FA_UPDATE_REEXEC:-}" = "1" ] && { : >&9; } 2>/dev/null; then
    :
  elif ! { exec 9>"$UPDATE_LOCK_FILE"; } 2>/dev/null; then
    log "WARN: could not open $UPDATE_LOCK_FILE; running without the update lock."
  fi
  if { : >&9; } 2>/dev/null && ! flock -n 9; then
    log "Another update is already running on this device; this run stops here."
    R_HOLD="An update is already running on this device. It finishes on its own; check back in a few minutes."
    _result 1 "" "" "" 0
  fi
else
  log "WARN: flock is missing; running without the update lock."
fi

# When this run started (kept across the re-exec), so the wait for the new
# version to answer, and a switch back after it, still end inside the host
# bridge's 600 second limit on the whole run.
RUN_STARTED_AT="$(date +%s)"
if [ "${FA_UPDATE_REEXEC:-}" = "1" ] && [[ "${FA_UPDATE_STARTED_AT:-}" =~ ^[0-9]+$ ]]; then
  RUN_STARTED_AT="$FA_UPDATE_STARTED_AT"
fi
UPDATE_BUDGET="${FA_UPDATE_BUDGET:-560}"

# Runs the release verifier in-process and prints the fields of its JSON
# answer the callers read, one per line, in the order _pyv reads them back
# (true/false as 1/0, a missing field as an empty line). One python3 start per
# check, instead of one for the check plus one more for every field read: on a
# Pi the interpreter start-up was most of the updater's run time.
IFS= read -r -d '' PYV_FIELDS <<'PYFIELDS' || true
import contextlib, io, json, sys
src = sys.argv[1]
sys.argv = ["pyverify"] + sys.argv[2:]
buf = io.StringIO()
try:
    with contextlib.redirect_stdout(buf):
        exec(compile(src, "pyverify", "exec"), {"__name__": "__main__"})
except SystemExit:
    pass
except Exception:
    pass
lines = [l for l in buf.getvalue().splitlines() if l.strip()]
try:
    d = json.loads(lines[-1]) if lines else {}
except ValueError:
    d = {}
if not isinstance(d, dict):
    d = {}
for key in ("ok", "reason", "commit", "version", "fingerprints", "result", "digest"):
    v = d.get(key, "")
    v = "1" if v is True else "0" if v is False else str(v)
    print(v.replace("\r", " ").replace("\n", " "))
PYFIELDS

# Run one verifier subcommand and set V_ok, V_reason, V_commit, V_version,
# V_fingerprints, V_result and V_digest from its answer (all empty when the
# verifier did not answer). Call it directly, not in $(...), so the values
# reach the caller.
_pyv() {
  local out
  out="$(python3 -c "$PYV_FIELDS" "$PYVERIFY" "$@" 2>/dev/null)"
  V_ok="" V_reason="" V_commit="" V_version="" V_fingerprints="" V_result="" V_digest=""
  {
    IFS= read -r V_ok; IFS= read -r V_reason; IFS= read -r V_commit
    IFS= read -r V_version; IFS= read -r V_fingerprints; IFS= read -r V_result
    IFS= read -r V_digest
  } <<<"$out"
  return 0
}

# Fingerprints of a signers file, comma-joined; empty when it holds no key.
_fingerprints() {
  _pyv fingerprints "$1"
  [ "$V_ok" = "1" ] || return 1
  printf '%s\n' "$V_fingerprints"
}

# The key lines of a signers file (blank lines and comments dropped), for
# comparing two lists.
_key_lines() {
  sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$1" 2>/dev/null \
    | grep -v -e '^$' -e '^#'
}

# Split an X.Y.Z version (surrounding whitespace and a leading v allowed, the
# same rule as the verifier's vcmp) into _VP, leading zeros dropped. Fails on
# anything else.
_vsplit() {
  local v="$1" p
  v="${v#"${v%%[![:space:]]*}"}"
  v="${v%"${v##*[![:space:]]}"}"
  v="${v#v}"
  [[ "$v" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || return 1
  _VP=()
  for p in "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"; do
    p="${p#"${p%%[!0]*}"}"
    _VP+=("${p:-0}")
  done
}

# Compare two X.Y.Z versions: prints -1, 0 or 1; nothing when unparseable.
# Plain bash (numbers compared by length, then digit by digit), so the several
# comparisons in a run start no interpreter.
_vcmp() {
  local -a a b
  local i x y
  _vsplit "$1" || return 1
  a=("${_VP[@]}")
  _vsplit "$2" || return 1
  b=("${_VP[@]}")
  for i in 0 1 2; do
    x="${a[$i]}" y="${b[$i]}"
    if [ "${#x}" -ne "${#y}" ]; then
      if [ "${#x}" -gt "${#y}" ]; then echo 1; else echo -1; fi
      return 0
    fi
    if [[ "$x" > "$y" ]]; then echo 1; return 0; fi
    if [[ "$x" < "$y" ]]; then echo -1; return 0; fi
  done
  echo 0
}

# Install a signers file over TRUST_FILE: root-owned, 0644, atomic.
_install_trust() {
  local src="$1" dir tmp
  dir="$(dirname "$TRUST_FILE")"
  mkdir -p "$dir" 2>/dev/null && chmod 0755 "$dir" 2>/dev/null
  tmp="$(mktemp "$dir/.release-signers.XXXXXX" 2>/dev/null)" || return 1
  if cat "$src" > "$tmp" && chmod 0644 "$tmp"; then
    chown root:root "$tmp" 2>/dev/null || true
    sync "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$TRUST_FILE" && return 0
  fi
  rm -f "$tmp" 2>/dev/null
  return 1
}

# Record what this device now runs (only after a successful deploy): the
# highest version installed is the next run's freshness floor, and the bridge
# relays the rest to the app as it is.
_write_state() {
  local fp body
  fp="$(_fingerprints "$TRUST_FILE" 2>/dev/null || true)"
  body="$(FLOOR="${floor:-}" TARGET="${target_ver:-}" SHA="${target_commit:-}" \
    CHANNEL="${channel:-}" FP="$fp" BOOT="${bootstrapped_at:-}" python3 -c '
import json, os, time
def vt(v):
    try:
        p = tuple(int(x) for x in v.split("."))
        return p if len(p) == 3 else None
    except ValueError:
        return None
vals = [v for v in (os.environ.get("FLOOR", ""), os.environ.get("TARGET", "")) if vt(v)]
high = max(vals, key=vt) if vals else ""
print(json.dumps({
    "highest_version": high,
    "sha": os.environ.get("SHA", ""),
    "channel": os.environ.get("CHANNEL", ""),
    "trust_fp": os.environ.get("FP", ""),
    "bootstrapped_at": os.environ.get("BOOT", ""),
    "updated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
}, sort_keys=True))' 2>/dev/null)" || return 0
  [ -n "$body" ] || return 0
  if _atomic_write "$STATE_FILE" "$body
" 2>/dev/null; then
    chmod 0644 "$STATE_FILE" 2>/dev/null || true
  else
    log "WARN: could not write $STATE_FILE."
  fi
}

# Change a few fields of STATE_FILE when nothing new was installed (a hold
# right after update signing was set up, or a switch back to the version that
# worked), keeping every other field as it was. Arguments are key=value pairs;
# an empty value removes the key. A missing highest_version is filled from the
# freshness floor, never from the target, so a held or failed release never
# raises the floor. A damaged file starts over from these fields.
_merge_state() {
  local body
  body="$(FLOOR="${floor:-}" python3 -c '
import json, os, re, sys
try:
    with open(sys.argv[1]) as fh:
        d = json.load(fh)
except Exception:
    d = {}
if not isinstance(d, dict):
    d = {}
for pair in sys.argv[2:]:
    key, _, value = pair.partition("=")
    if value:
        d[key] = value
    else:
        d.pop(key, None)
floor = os.environ.get("FLOOR", "")
hv = d.get("highest_version")
if not (isinstance(hv, str) and re.match(r"^[0-9]+\.[0-9]+\.[0-9]+$", hv)):
    d["highest_version"] = floor if re.match(r"^[0-9]+\.[0-9]+\.[0-9]+$", floor) else ""
print(json.dumps(d, sort_keys=True))' "$STATE_FILE" "$@" 2>/dev/null)" || return 0
  [ -n "$body" ] || return 0
  if _atomic_write "$STATE_FILE" "$body
" 2>/dev/null; then
    chmod 0644 "$STATE_FILE" 2>/dev/null || true
  else
    log "WARN: could not write $STATE_FILE."
  fi
}

# Scratch space for this run (removed on every exit through _result).
RUN_TMP="$(mktemp -d 2>/dev/null || mktemp -d -t fa-update.XXXXXX)"

# Find the git checkout.
REPO=""
for cand in $REPO_CANDIDATES; do
  [ -n "$cand" ] || continue
  if [ -d "$cand/.git" ]; then REPO="$cand"; break; fi
done
if [ -z "$REPO" ]; then
  log "No git checkout found (looked in: $REPO_CANDIDATES)."
  _result 0 "No git checkout found on this device; cannot update." "" "" 0
fi
log "Using git checkout at $REPO"

before="$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo unknown)"
old_head="$(git -C "$REPO" rev-parse HEAD 2>/dev/null || true)"
log "Current commit: $before"
if [ "$ALLOW_UNSIGNED_ONCE" = "1" ]; then
  log "Running with --allow-unsigned-once: this run installs one release without checking its signature."
fi

# --- Release trust: tools, channel, anchor, target, freshness ----------------
# Nothing below installs anything until the target is verified, staged and
# (on a Docker install) matched to its signed release record.

# ssh-keygen -Y verify checks every signature. Install it when it is missing
# (best effort and time-bounded, like the package retrofits further down).
if [ "$ALLOW_UNSIGNED_ONCE" != "1" ]; then
  if ! command -v ssh-keygen >/dev/null 2>&1; then
    log "ssh-keygen is missing; installing openssh-client."
    DEBIAN_FRONTEND=noninteractive timeout 120 apt-get install -y \
      --no-install-recommends openssh-client >/dev/null 2>&1 \
      || { DEBIAN_FRONTEND=noninteractive timeout 120 apt-get update >/dev/null 2>&1 \
           && DEBIAN_FRONTEND=noninteractive timeout 120 apt-get install -y \
              --no-install-recommends openssh-client >/dev/null 2>&1; } || true
  fi
  if ! command -v ssh-keygen >/dev/null 2>&1; then
    R_HOLD="This device cannot check update signatures because ssh-keygen is missing. Run sudo apt-get install openssh-client, then update again."
    _result 0 "$R_HOLD" "$before" "$before" 0
  fi
  _yprobe="$(ssh-keygen -Y verify 2>&1 </dev/null || true)"
  case "$_yprobe" in
    *"illegal option"*|*"unknown option"*|*"invalid option"*)
      R_HOLD="This device's OpenSSH is too old to check update signatures. Reflash it with a current Raspberry Pi OS, or run sudo foodassistant-update --allow-unsigned-once to install one release without the check."
      _result 0 "$R_HOLD" "$before" "$before" 0
      ;;
  esac
fi

# Resolve the update channel: the env var wins, then the persisted file. Only
# "main" means main; a missing or empty file, or any other value, is stable.
channel="${UPDATE_CHANNEL:-}"
if [ -z "$channel" ] && [ -f "$CHANNEL_FILE" ]; then
  channel="$(head -n1 "$CHANNEL_FILE" 2>/dev/null | tr -d '[:space:]')"
fi
case "$channel" in main) ;; *) channel="stable" ;; esac
log "Update channel: $channel"
R_CHANNEL="$channel"

# The trust anchor for this run: the installed list, or (first verified
# update on this device) the list built into this updater.
BOOTSTRAP=0
SIGNERS=""
_anchor_fp=""
if [ -f "$TRUST_FILE" ] && _anchor_fp="$(_fingerprints "$TRUST_FILE")"; then
  SIGNERS="$TRUST_FILE"
else
  _anchor_fp=""
  BOOTSTRAP=1
  if [ -f "$TRUST_FILE" ]; then
    log "WARN: $TRUST_FILE holds no release key; setting up update signing again."
  fi
  if [ -n "$FA_BOOTSTRAP_SIGNERS" ]; then
    SIGNERS="$FA_BOOTSTRAP_SIGNERS"
  else
    SIGNERS="$RUN_TMP/release-signers"
    printf '%s' "$EMBEDDED_SIGNERS" > "$SIGNERS"
  fi
fi
# The installed list was just read above; only a bootstrap anchor needs a look.
if [ "$BOOTSTRAP" = "1" ]; then
  R_TRUST_FP="$(_fingerprints "$SIGNERS" || true)"
else
  R_TRUST_FP="$_anchor_fp"
fi
bootstrapped_at=""
if [ "${FA_UPDATE_REEXEC:-}" = "1" ] && [ -n "${FA_UPDATE_BOOTSTRAPPED_AT:-}" ]; then
  # The run before the re-exec set up update signing.
  bootstrapped_at="$FA_UPDATE_BOOTSTRAPPED_AT"
fi

# Install the anchor as this device's release-key list once a target
# verified with it (bootstrap only).
_bootstrapped_now=0
_bootstrap_trust() {
  [ "$BOOTSTRAP" = "1" ] || return 0
  if _install_trust "$SIGNERS"; then
    BOOTSTRAP=0
    _bootstrapped_now=1
    SIGNERS="$TRUST_FILE"
    bootstrapped_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    R_TRUST_FP="$(_fingerprints "$TRUST_FILE" || true)"
    log "Update signing is set up on this device (release key $R_TRUST_FP)."
  else
    log "WARN: could not write $TRUST_FILE; update signing is set up again on the next run."
  fi
}

# The running version: the app itself when it answers, else the deployed
# code, else the image tag in the stack .env. Never the checkout, which can
# be ahead of what runs.
_running_version() {
  local v=""
  if [ -n "$FA_RUNNING_VERSION" ]; then
    printf '%s' "$FA_RUNNING_VERSION"; return 0
  fi
  if [ -f "$INSTALL_DIR/docker-compose.yml" ] && command -v docker >/dev/null 2>&1; then
    v="$(python3 -c '
import json, time, urllib.request
for attempt in range(2):
    try:
        with urllib.request.urlopen("http://127.0.0.1:9284/health", timeout=3) as r:
            d = json.loads(r.read(65536).decode("utf-8", "replace"))
        if isinstance(d, dict) and d.get("app") == "foodassistant":
            print(str(d.get("version", "")))
            break
    except Exception:
        time.sleep(1)
' 2>/dev/null)"
  fi
  if [ -z "$v" ] && [ -f "$APP_DIR/app/config.py" ]; then
    v="$(grep -m1 -E '^APP_VERSION' "$APP_DIR/app/config.py" 2>/dev/null \
         | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)"
  fi
  if [ -z "$v" ] && [ -f "$ENV_FILE" ]; then
    v="$(grep '^FOODASSISTANT_TAG=' "$ENV_FILE" 2>/dev/null | tail -n1 | cut -d= -f2- \
         | grep -oE '^v?[0-9]+\.[0-9]+\.[0-9]+(@sha256:[0-9a-f]+)?$' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)"
  fi
  printf '%s' "$v" | grep -E '^v?[0-9]+\.[0-9]+\.[0-9]+$' | sed 's/^v//'
}
running="$(_running_version || true)"
running_label="${running:-its current version}"
if [ -n "$running" ]; then
  log "Running version: $running"
else
  log "Running version: unknown"
fi

# The freshness floor: the highest version this updater installed, else the
# running version. A damaged state file is ignored. The second line read here
# is the version that last failed to start and was switched back from.
floor=""
failed_ver=""
if [ -f "$STATE_FILE" ]; then
  _state="$(python3 -c '
import json, re, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    print("BAD"); sys.exit(0)
if not isinstance(d, dict):
    print("BAD"); sys.exit(0)
v = d.get("highest_version", "")
b = d.get("bootstrapped_at", "")
r = d.get("rollback_version", "")
v = v if isinstance(v, str) and re.match(r"^[0-9]+\.[0-9]+\.[0-9]+$", v) else ""
b = b if isinstance(b, str) and re.match(r"^[0-9T:Z.+-]{1,40}$", b) else ""
r = r if isinstance(r, str) and re.match(r"^[0-9]+\.[0-9]+\.[0-9]+$", r) else ""
print(v + " " + b)
print(r)
' "$STATE_FILE" 2>/dev/null)"
  if [ "$_state" = "BAD" ] || [ -z "$_state" ]; then
    log "WARN: $STATE_FILE is damaged; ignoring it."
  else
    case "$_state" in
      *$'\n'*) failed_ver="${_state#*$'\n'}"; _state="${_state%%$'\n'*}" ;;
    esac
    floor="${_state%% *}"
    [ -n "$bootstrapped_at" ] || bootstrapped_at="${_state#* }"
  fi
fi
[ -n "$floor" ] || floor="$running"

# A version pin, when one is set. Read before any tag is resolved so the pin,
# not the newest release, is what the rest of this run targets (checkout and
# the app image tag alike). Logged on every run so a device that seems stuck
# on an old version explains itself in the update log.
pinned_ver=""
if [ -f "$PINNED_VERSION_FILE" ]; then
  pinned_ver="$(head -n1 "$PINNED_VERSION_FILE" 2>/dev/null | tr -d '[:space:]')"
  case "$pinned_ver" in
    ""|v) pinned_ver="" ;;
    v*) ;;
    *) pinned_ver="v$pinned_ver" ;;
  esac
fi
if [ -n "$pinned_ver" ]; then
  log "Version pin: $PINNED_VERSION_FILE holds $pinned_ver."
  if [ "$channel" != "stable" ]; then
    log "The pin applies on the stable channel; this device follows the main channel, so it is ignored."
  fi
fi

# A verification failure: hold with the bootstrap message when update signing
# is not set up yet, else with MSG.
_verify_hold() {
  if [ "$BOOTSTRAP" = "1" ] && [ "$ALLOW_UNSIGNED_ONCE" != "1" ]; then
    R_HOLD="Update signing could not be set up from this download; the device stays on $running_label and will try again."
  else
    R_HOLD="$1"
  fi
  _result 0 "$R_HOLD" "$before" "$before" 0
}

# Check one release tag: sets the V_* fields (see _pyv).
_check_tag() {
  if [ "$ALLOW_UNSIGNED_ONCE" = "1" ]; then
    _pyv inspect-tag "$REPO" "$1"
  else
    _pyv verify-tag "$REPO" "$1" "$SIGNERS"
  fi
}

# Why a tag was skipped, for the log.
_skip_line() {
  case "$2" in
    not_annotated) log "$1 is not an annotated tag; skipped." ;;
    name_mismatch) log "$1 names another tag; skipped." ;;
    version_mismatch) log "$1 does not match its version; skipped." ;;
    missing) log "$1 could not be read; skipped." ;;
    *) log "$1 is not signed by the Pantry Raider release key; skipped." ;;
  esac
}

release_tag=""
target_commit=""
target_ver=""
recovered=0
fetched_main=0
if [ "$channel" = "stable" ]; then
  # Stable channel: the newest release tag that verifies. A tag ref can be
  # moved, so each one is fetched on its own and checked from the signed
  # object: its signature, the name inside it, and the version in its tree.
  log "Fetching release tags..."
  if _ls="$(git -C "$REPO" ls-remote --tags --refs origin 'refs/tags/v*' 2>&1)"; then
    _names="$(printf '%s\n' "$_ls" | awk '{print $2}' | sed 's|^refs/tags/||')"
  else
    log "Could not list release tags (offline or no upstream); using the tags this device already has:"
    log "$_ls"
    _names="$(git -C "$REPO" tag -l 'v*')"
  fi
  _names="$(printf '%s\n' "$_names" | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -rV | head -n 20)"
  _fetch_tag() {
    git -C "$REPO" fetch --force --no-tags origin "+refs/tags/$1:refs/tags/$1" >/dev/null 2>&1 || true
  }
  if [ -n "$pinned_ver" ]; then
    _fetch_tag "$pinned_ver"
    if git -C "$REPO" rev-parse -q --verify "refs/tags/$pinned_ver" >/dev/null 2>&1; then
      _check_tag "$pinned_ver"
      if [ "$V_ok" != "1" ]; then
        _skip_line "$pinned_ver" "$V_reason"
        _verify_hold "The pinned release $pinned_ver could not be verified; this device stays on $running_label."
      fi
      release_tag="$pinned_ver"
      target_commit="$V_commit"
      target_ver="$V_version"
      log "Staying on the pinned release $release_tag."
    else
      log "WARN: no release tag matches the pinned version $pinned_ver; following the newest release instead."
    fi
  fi
  if [ -z "$release_tag" ]; then
    if [ -z "$_names" ]; then
      log "No release tags found; keeping the current checkout until a release is published."
    fi
    for _t in $_names; do
      _fetch_tag "$_t"
      _check_tag "$_t"
      if [ "$V_ok" = "1" ]; then
        release_tag="$_t"
        target_commit="$V_commit"
        target_ver="$V_version"
        break
      fi
      _skip_line "$_t" "$V_reason"
    done
  fi
  if [ -z "$release_tag" ]; then
    _verify_hold "No signed release is available yet; this device stays on $running_label and will try again."
  fi
  if [ "$ALLOW_UNSIGNED_ONCE" = "1" ]; then
    log "UNVERIFIED: installing $release_tag without checking its signature (--allow-unsigned-once)."
  else
    log "Release $release_tag is signed by the Pantry Raider release key."
  fi
else
  # Main channel: the signed tip of main. Never a second pull after the
  # check: the device moves to exactly the commit that verified.
  log "Fetching main..."
  if _fo="$(git -C "$REPO" fetch origin +refs/heads/main:refs/remotes/origin/main 2>&1)"; then
    [ -n "$_fo" ] && log "$_fo"
    fetched_main=1
    target_commit="$(git -C "$REPO" rev-parse refs/remotes/origin/main 2>/dev/null || true)"
  else
    log "Could not fetch origin main (offline or no upstream); continuing with the current checkout:"
    log "$_fo"
    target_commit="$old_head"
  fi
  if [ "$ALLOW_UNSIGNED_ONCE" = "1" ]; then
    _pyv inspect-commit "$REPO" "${target_commit:-HEAD}"
  else
    _pyv verify-commit "$REPO" "${target_commit:-HEAD}" "$SIGNERS"
  fi
  if [ "$V_ok" != "1" ]; then
    log "Main channel check: $V_reason."
    _verify_hold "The newest change is not signed by the Pantry Raider release key; this device stays on $running_label."
  fi
  target_commit="$V_commit"
  target_ver="$V_version"
  if [ "$ALLOW_UNSIGNED_ONCE" = "1" ]; then
    log "UNVERIFIED: installing ${target_commit:0:12} without checking its signature (--allow-unsigned-once)."
  else
    log "The tip of main (${target_commit:0:12}) is signed by the Pantry Raider release key."
  fi
  if [ "$fetched_main" = "1" ] && [ -n "$old_head" ] \
      && ! git -C "$REPO" merge-base --is-ancestor "$old_head" "$target_commit" >/dev/null 2>&1; then
    recovered=1
  fi
fi
R_TARGET="$target_ver"
if [ "$ALLOW_UNSIGNED_ONCE" = "1" ]; then
  R_VERIFIED=0
  if [ "$BOOTSTRAP" = "1" ]; then
    # The embedded list, never one from the unverified tree.
    _bootstrap_trust
  fi
else
  R_VERIFIED=1
  _bootstrap_trust
fi

# Freshness: never move below what this device already ran, unless that is
# the version it is pinned to. An equal version redeploys.
if [ -n "$floor" ] && [ -n "$target_ver" ]; then
  _c="$(_vcmp "$target_ver" "$floor")"
  if [ "$_c" = "-1" ]; then
    if [ "$channel" = "stable" ] && [ -n "$pinned_ver" ] && [ "$release_tag" = "$pinned_ver" ]; then
      log "Moving down to the pinned release $pinned_ver (this device was on $floor)."
    else
      R_HOLD="This device is on $floor; the newest signed release is $target_ver. It moves with the next release."
      log "$R_HOLD"
      if [ "$_bootstrapped_now" = "1" ]; then
        # Update signing was just set up on this device; record when, even
        # though nothing is installed this time.
        _merge_state "bootstrapped_at=$bootstrapped_at" "trust_fp=$R_TRUST_FP"
      fi
      _result 1 "" "$before" "$before" 0
    fi
  fi
fi

# A scheduled run does not try again a version that failed to start here and
# was switched back from: each try takes the app down for the health wait.
# The hold lasts until a different version is the target (the next release,
# or the next change on main), and a manual run always tries. When that
# version is what runs now after all (it came up after a restart), the run
# goes ahead, which also clears the note in Settings.
if [ "$SCHEDULED" = "1" ] && [ -n "$failed_ver" ] && [ -n "$target_ver" ] \
    && [ "$target_ver" = "$failed_ver" ] && [ "${running:-}" != "$target_ver" ]; then
  R_HOLD="Pantry Raider $target_ver did not start on this device last time; waiting for the next release. Press Update now to try it again."
  log "$R_HOLD"
  if [ "$_bootstrapped_now" = "1" ]; then
    _merge_state "bootstrapped_at=$bootstrapped_at" "trust_fp=$R_TRUST_FP"
  fi
  _result 1 "" "$before" "$before" 0
fi

# --- Staging -------------------------------------------------------------------
# The verified commit is exported to its own release directory. Nothing a
# running service reads changes until the export is complete and (on a Docker
# install) the signed release record checks out: the checkout and the current
# link move only after that, so every hold below leaves the device as it was.
mkdir -p "$STAGE_ROOT" 2>/dev/null || true
_avail_kb="$(df -Pk "$STAGE_ROOT" 2>/dev/null | awk 'NR == 2 { print $4 }')"
if [ -n "$_avail_kb" ] && [ "$_avail_kb" -lt $((STAGE_MIN_MB * 1024)) ] 2>/dev/null; then
  R_HOLD="There is not enough free space on this device to stage the update (about 200 MB is needed)."
  _result 0 "$R_HOLD" "$before" "$before" 0 0 0 0 "$recovered"
fi
_rel_name="${target_ver:-unknown}-${target_commit:0:7}"
_rel_dir="$STAGE_ROOT/$_rel_name"
if [ ! -d "$_rel_dir" ]; then
  _rel_tmp="$STAGE_ROOT/.$_rel_name.tmp"
  rm -rf "$_rel_tmp" 2>/dev/null
  if mkdir -p "$_rel_tmp" \
      && git -C "$REPO" archive --format=tar "$target_commit" | tar -x --no-same-owner -C "$_rel_tmp" \
      && mv -T "$_rel_tmp" "$_rel_dir"; then
    log "Staged release ${target_ver:-unknown} at $_rel_dir."
  else
    rm -rf "$_rel_tmp" 2>/dev/null
    R_HOLD="The update could not be unpacked on this device; it stays on $running_label and will try again."
    _result 0 "$R_HOLD" "$before" "$before" 0 0 0 0 "$recovered"
  fi
else
  log "Reusing the staged release at $_rel_dir."
fi

# --- App image record (Docker installs) ------------------------------------------
# Before anything is installed: on the stable channel the image comes from
# the signed release record (release.json), pinned to its digest.
DOCKER_LAYOUT=0
if [ -f "$INSTALL_DIR/docker-compose.yml" ] && command -v docker >/dev/null 2>&1; then
  DOCKER_LAYOUT=1
fi
IMAGE_REF=""
_cur_env_tag="$(grep '^FOODASSISTANT_TAG=' "$ENV_FILE" 2>/dev/null | tail -n1 | cut -d= -f2-)"
if [ "$DOCKER_LAYOUT" = "1" ]; then
  if [ "$channel" = "stable" ]; then
    _mdir="$RUN_TMP/manifest"
    mkdir -p "$_mdir"
    _mreason=""
    _pyv fetch "$RELEASE_BASE_URL/v$target_ver/release.json" "$_mdir/release.json"
    if [ "$V_ok" != "1" ]; then
      _mreason="release.json $V_reason"
    else
      _pyv fetch "$RELEASE_BASE_URL/v$target_ver/release.json.sig" "$_mdir/release.json.sig"
      if [ "$V_ok" != "1" ]; then
        _mreason="release.json.sig $V_reason"
      else
        # The signature must positively check out; a verifier that fails to
        # answer counts as a bad signature.
        _msig_ok=1
        if [ "$ALLOW_UNSIGNED_ONCE" != "1" ]; then
          _pyv verify-file "$_mdir/release.json" "$_mdir/release.json.sig" "$SIGNERS" pantryraider-release
          if [ "$V_ok" != "1" ]; then
            _msig_ok=0
            _mreason="signature $V_reason"
          fi
        fi
        if [ "$_msig_ok" = "1" ]; then
          _pyv check-manifest "$_mdir/release.json" "$target_ver" "$target_commit"
          if [ "$V_ok" = "1" ]; then
            IMAGE_REF="$target_ver@$V_digest"
            log "Release $target_ver: the signed record pins the app image to $IMAGE_REF."
          else
            _mreason="record $V_reason"
          fi
        fi
      fi
    fi
    if [ -z "$IMAGE_REF" ]; then
      if [ "$ALLOW_UNSIGNED_ONCE" = "1" ] || [ "$(_vcmp "$target_ver" "$MANIFEST_REQUIRED_AFTER")" != "1" ]; then
        IMAGE_REF="$target_ver"
        log "Release $target_ver: image not digest-pinned ($_mreason); pulling by version."
      else
        log "Release $target_ver: no valid signed record ($_mreason)."
        R_HOLD="The signed record for release $target_ver is not published yet; this device stays on $running_label and will try again."
        _result 0 "$R_HOLD" "$before" "$before" 0 0 0 0 "$recovered"
      fi
    fi
  else
    # :latest moves only on signed releases now, so the main channel follows
    # :main. An operator's own tag is left alone.
    case "$_cur_env_tag" in
      ""|latest) IMAGE_REF="main" ;;
    esac
  fi
fi

# --- Checkout and the current export ---------------------------------------------
# The checkout follows the verified commit (it is the REPO_DIR the stack's
# Grocy start-up hook mounts), but nothing is installed from it: every host
# install below reads the export in STAGE_ROOT/current.
_was_detached=0
git -C "$REPO" symbolic-ref -q HEAD >/dev/null 2>&1 || _was_detached=1
if [ "$channel" = "stable" ]; then
  if [ "$old_head" = "$target_commit" ]; then
    log "Already on release $release_tag."
  fi
  if co_out="$(git -C "$REPO" checkout --force --detach "$target_commit" 2>&1)"; then
    [ "$old_head" = "$target_commit" ] || log "Checked out release $release_tag."
  else
    log "WARN: could not check out $release_tag in the checkout (the export is used either way):"
    log "$co_out"
  fi
else
  if co_out="$(git -C "$REPO" checkout --force -B main "$target_commit" 2>&1)"; then
    git -C "$REPO" branch --set-upstream-to=origin/main main >/dev/null 2>&1 || true
    if [ "$_was_detached" = "1" ]; then
      log "Reattached the checkout to main."
    fi
    if [ "$recovered" = "1" ]; then
      log "Recovered: reset the checkout to origin/main."
    fi
  else
    log "WARN: could not move the checkout to ${target_commit:0:12} (the export is used either way):"
    log "$co_out"
  fi
fi

after="$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo unknown)"
log "Checkout now at: $after"

_prev_rel="$(readlink "$STAGE_ROOT/current" 2>/dev/null || true)"
_prev_rel="${_prev_rel##*/}"
ln -sfn "$_rel_name" "$STAGE_ROOT/.current.tmp" && mv -T -f "$STAGE_ROOT/.current.tmp" "$STAGE_ROOT/current"
for _d in "$STAGE_ROOT"/* "$STAGE_ROOT"/.*.tmp; do
  [ -d "$_d" ] && [ ! -L "$_d" ] || continue
  case "${_d##*/}" in
    "$_rel_name"|current) continue ;;
  esac
  [ -n "$_prev_rel" ] && [ "${_d##*/}" = "$_prev_rel" ] && continue
  rm -rf "$_d" 2>/dev/null || true
done
SRC="$STAGE_ROOT/current"
if [ ! -d "$SRC/." ]; then
  R_HOLD="The update could not be unpacked on this device; it stays on $running_label and will try again."
  _result 0 "$R_HOLD" "$before" "$after" 0 0 0 0 "$recovered"
fi

# --- Release-key list ----------------------------------------------------------
# A verified release can carry a new release-key list (a backup key added, or
# a key retired). It verified under the installed list, so its list is
# trusted from this release on. Older releases carry none. A pinned move down
# to an older release never takes its list: that list predates keys a later
# release added, and going back to it could leave the device unable to check
# the releases that come after.
_trust_downgrade=0
if [ -n "$floor" ] && [ -n "$target_ver" ] && [ "$(_vcmp "$target_ver" "$floor")" = "-1" ]; then
  _trust_downgrade=1
fi
if [ "$ALLOW_UNSIGNED_ONCE" != "1" ]; then
  _new_signers="$SRC/scripts/release-signers"
  if [ -f "$_new_signers" ] && _new_fp="$(_fingerprints "$_new_signers")"; then
    if [ "$(_key_lines "$_new_signers")" = "$(_key_lines "$TRUST_FILE")" ]; then
      :
    elif [ "$_trust_downgrade" = "1" ]; then
      log "Kept the installed release-key list: release $target_ver is older than one this device already ran."
    else
      if _install_trust "$_new_signers"; then
        # The installed file is a byte copy of the list just read.
        R_TRUST_FP="$_new_fp"
        log "Installed the release-key list from release ${target_ver:-unknown} (release keys $_new_fp)."
      else
        log "WARN: could not install the release-key list from release ${target_ver:-unknown}."
      fi
    fi
  else
    log "This release carries no release-key list; keeping the installed one."
  fi
fi

restarted=0
svc_synced=0
sd_synced=0
gd_synced=0
deps=0

# Which account the host services run as. Ownership of the venv used to answer
# this, but the venv is root-owned now (see secure_python_tree), so the answer
# comes from the units themselves, then from the interactive account the
# Raspberry Pi Imager created. The literal fallback is last: on most images no
# such account exists.
_service_user() {
  local u="" f
  # The gadgets unit first: it is the reader that needs the i2c group, and it
  # is the only caller of this helper. A unit running as root answers nothing
  # (root is already in every group and is not the account to add), so keep
  # looking. Same order and same root skip as foodassistant-gadgets-setup.
  # UNIT_DIR is overridable for tests, like KIOSK_UNIT and the other unit paths.
  local unit_dir="${UNIT_DIR:-/etc/systemd/system}"
  for f in "$unit_dir/$GD_SERVICE" \
           "$unit_dir/$SD_SERVICE" \
           "$unit_dir/$SERVICE"; do
    [ -f "$f" ] || continue
    u="$(grep -m1 '^User=' "$f" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]')"
    if [ -n "$u" ] && [ "$u" != "root" ]; then printf '%s\n' "$u"; return 0; fi
  done
  u="$(getent passwd 1000 2>/dev/null | cut -d: -f1)"
  printf '%s\n' "${u:-foodassistant}"
}

# One-time retrofit for devices flashed before the code tree was tightened.
# Root runs python out of this venv (the host bridge asks the Stream Deck
# controller for its key layout and its action list, and the pip step below
# runs as root), so a venv or package the desktop account can write to means
# anyone with that account runs code as root. Hand the code back to root,
# world-readable so every service can still read and execute it, and leave the
# data and config paths alone: those are the parts that must stay writable.
# Cheap and idempotent: already-root trees are skipped without a chown.
secure_python_tree() {
  local p owner
  for p in "$VENV_DIR" "$SD_DST" "$GD_DST"; do
    [ -d "$p" ] || continue
    owner="$(stat -c %U "$p" 2>/dev/null || echo root)"
    [ "$owner" = "root" ] && continue
    log "Securing $p (was owned by $owner; the code tree belongs to root)."
    chown -R root:root "$p" 2>/dev/null || log "WARN: could not chown $p to root."
    chmod -R a+rX "$p" 2>/dev/null || true
  done
}
secure_python_tree

# Sync the host-side Stream Deck package from the checkout to SD_DST. The deck
# runs as its own host systemd unit, NOT inside the app container, so the
# pi_hosted Docker update path never touches it. Both the Docker path and the
# venv path must call this or deck-only code changes never reach a hosted
# device (FoodAssistant-aus1: the Docker branch returned before the deck sync
# and left the deck stale). Sets sd_synced=1 on success; the caller restarts
# SD_SERVICE.
sync_streamdeck() {
  local sd_src="$SRC/streamdeck/foodassistant_streamdeck"
  if [ ! -d "$sd_src" ]; then
    log "No streamdeck package in the checkout; skipping deck sync."
    return 0
  fi
  local sd_parent; sd_parent="$(dirname "$SD_DST")"
  if [ ! -d "$sd_parent" ]; then
    log "Stream Deck parent dir $sd_parent does not exist; skipping deck sync."
    return 0
  fi
  log "Syncing Stream Deck package into $SD_DST"
  # Replace any prior copy outright. Copying into an existing target dir nests
  # the package one level too deep (SD_DST/foodassistant_streamdeck), which
  # leaves __main__.py unreachable and breaks `python -m`.
  rm -rf "$SD_DST"
  if cp -a "$sd_src" "$SD_DST"; then
    # Manual installs have landed with mode 700 and broken the service; make
    # the tree world-readable. Ownership stays with root: root runs python
    # from this package (the bridge asks the controller for its layout and
    # actions), so a copy the desktop account could write to would be code
    # running as root. The controller only reads it.
    chown -R root:root "$SD_DST" 2>/dev/null || true
    chmod -R a+rX "$SD_DST" 2>/dev/null || true
    sd_synced=1
  else
    log "WARN: could not sync $SD_DST"
  fi
}

# Sync the host-side Bluetooth thermometer reader the same way. Like the deck
# it is a host systemd unit the Docker update path never touches. The reader
# is OPT-IN (installed by foodassistant-gadgets-setup); an install that never
# opted in has no GD_DST, and this is then a silent no-op, so a normal update
# never grows the feature onto a device uninvited.
sync_gadgets() {
  local gd_src="$SRC/gadgets/foodassistant_gadgets"
  if [ ! -d "$gd_src" ] || [ ! -d "$GD_DST" ]; then
    return 0
  fi
  log "Syncing thermometer reader package into $GD_DST"
  # Replace outright: copying into an existing dir nests the package one
  # level too deep and breaks `python -m` (same trap as the deck).
  rm -rf "$GD_DST"
  if cp -a "$gd_src" "$GD_DST"; then
    # Root-owned and world-readable, same reasoning as the deck package: the
    # reader runs it out of a venv that root also uses.
    chown -R root:root "$GD_DST" 2>/dev/null || true
    chmod -R a+rX "$GD_DST" 2>/dev/null || true
    gd_synced=1
  else
    log "WARN: could not sync $GD_DST"
  fi
}

# Keep ALL installed helper scripts current so future runs use the latest
# versions, from the verified export. Overwriting the running script in place
# is safe (the open inode keeps executing). Done before the deploy branches so
# both the Docker (Pi Hosted) and venv (Pi Remote) paths pick up newer
# helpers. Every extensionless foodassistant-* file in scripts/image-build is
# a bin helper (display-power, set-rotation, apply-rotation, accel-rotation,
# restore, this script); syncing the whole set also INSTALLS helpers that did
# not exist when the device was imaged (FoodAssistant-2ty6). The host bridge
# is excluded here: it is a long-running daemon with its own
# refresh-and-scheduled-restart block below.
#
# The updater itself is replaced only by one of at least this generation, so
# a redeploy or a pinned downgrade of an older release never puts back an
# updater that cannot check signatures.
_generation_of() {
  local g
  g="$(grep -m1 -E '^UPDATER_TRUST_GENERATION=[0-9]+[[:space:]]*$' "$1" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]')"
  printf '%s' "${g:-0}"
}
_self_updated=0
for _hsrc in "$SRC/scripts/image-build/foodassistant-"*; do
  [ -f "$_hsrc" ] || continue
  _h="$(basename "$_hsrc")"
  case "$_h" in
    foodassistant-host-bridge) continue ;;
    *.*) continue ;;  # unit files and provisioning scripts, not bin helpers
  esac
  _h_existed=0
  [ -f "$BIN_DIR/$_h" ] && _h_existed=1
  if ! cmp -s "$_hsrc" "$BIN_DIR/$_h"; then
    if [ "$_h" = "foodassistant-update" ] \
        && [ "$(_generation_of "$_hsrc")" -lt "$UPDATER_TRUST_GENERATION" ]; then
      log "Kept the current updater: the release being installed carries one that cannot check signatures."
      continue
    fi
    if install -m 755 "$_hsrc" "$BIN_DIR/$_h" 2>/dev/null; then
      log "Refreshed $BIN_DIR/$_h"
      # Only a REPLACED updater warrants a re-exec; a first-time install means
      # this very run is already the newest version.
      if [ "$_h" = "foodassistant-update" ] && [ "$_h_existed" = "1" ]; then
        _self_updated=1
      fi
    else
      log "WARN: could not refresh $BIN_DIR/$_h"
    fi
  fi
done

# When THIS script just replaced itself, the rest of this run would still
# execute the old version (the shell keeps the old inode), so any step added
# in the new version would only apply on the NEXT update press. Re-exec the
# fresh copy once, with the same arguments; the guard env stops a loop. The
# re-run verifies the target again and reuses the staged export.
if [ "$_self_updated" = "1" ] && [ -z "${FA_UPDATE_REEXEC:-}" ] \
    && [ -x "$BIN_DIR/foodassistant-update" ]; then
  log "Updater refreshed itself; re-running the new version so every new step applies now."
  rm -rf "$RUN_TMP" 2>/dev/null
  FA_UPDATE_REEXEC=1 FA_UPDATE_BOOTSTRAPPED_AT="$bootstrapped_at" \
    FA_UPDATE_STARTED_AT="$RUN_STARTED_AT" \
    exec "$BIN_DIR/foodassistant-update" ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}
fi

# Local credentials for the host services (the deck and thermometer reader
# keys, the kiosk launch ticket). Releases from 0.21 on carry the helper; an
# older release (a pinned downgrade) is deployed as it shipped.
KIOSK_UNIT_CHANGED=0
if [ -f "$SRC/scripts/image-build/foodassistant-host-harden" ] \
    && [ -x "$BIN_DIR/foodassistant-host-harden" ]; then
  # Time-bounded, so a stuck helper never holds the update past the bridge's
  # limit.
  if command -v timeout >/dev/null 2>&1; then
    _hh_out="$(timeout 120 "$BIN_DIR/foodassistant-host-harden" local-credentials 2>/dev/null)"
  else
    _hh_out="$("$BIN_DIR/foodassistant-host-harden" local-credentials 2>/dev/null)"
  fi
  _hh_last="$(printf '%s\n' "$_hh_out" | grep -v '^[[:space:]]*$' | tail -n1)"
  log "Local credentials: ${_hh_last:-no summary}"
  if HH_JSON="$_hh_last" python3 -c '
import json, os, sys
try:
    d = json.loads(os.environ.get("HH_JSON", ""))
except ValueError:
    sys.exit(1)
changed = d.get("changed", []) if isinstance(d, dict) else []
sys.exit(0 if isinstance(changed, list) and any(
    isinstance(c, str) and c.startswith("kiosk") for c in changed) else 1)
' 2>/dev/null; then
    KIOSK_UNIT_CHANGED=1
  fi
  # The home Wi-Fi password cloud-init left on the SD card's boot partition
  # comes off once the device keeps its own copy (the helper checks that and
  # leaves the card alone otherwise). Appliances only: an install.sh server
  # (deployment_mode "server") is somebody's own machine and keeps its
  # cloud-init setup as it is.
  _bw_mode=""
  if [ -r "$SETTINGS_JSON" ]; then
    _bw_mode="$(grep -o '"deployment_mode"[[:space:]]*:[[:space:]]*"[^"]*"' "$SETTINGS_JSON" 2>/dev/null \
      | head -n1 | sed 's/.*"\([^"]*\)"$/\1/' || true)"
  fi
  if [ "$_bw_mode" != "server" ] \
      && grep -q 'boot-wifi-psk' "$BIN_DIR/foodassistant-host-harden" 2>/dev/null; then
    if command -v timeout >/dev/null 2>&1; then
      _bw_out="$(timeout 60 "$BIN_DIR/foodassistant-host-harden" boot-wifi-psk 2>&1)"
    else
      _bw_out="$("$BIN_DIR/foodassistant-host-harden" boot-wifi-psk 2>&1)"
    fi
    log "Boot partition Wi-Fi password: $(printf '%s\n' "$_bw_out" | grep -v '^[[:space:]]*$' | tail -n1)"
  fi
  if [ "$_bw_mode" != "server" ] \
      && grep -q 'boot-password-hash' "$BIN_DIR/foodassistant-host-harden" 2>/dev/null; then
    if command -v timeout >/dev/null 2>&1; then
      _bh_out="$(timeout 60 "$BIN_DIR/foodassistant-host-harden" boot-password-hash 2>&1)"
    else
      _bh_out="$("$BIN_DIR/foodassistant-host-harden" boot-password-hash 2>&1)"
    fi
    log "Boot partition password hash: $(printf '%s\n' "$_bh_out" | grep -v '^[[:space:]]*$' | tail -n1)"
  fi
fi

# Keep the host bridge current too. It is a long-running root daemon (on
# 127.0.0.1:9299), NOT a re-exec'd helper, so a new file only takes effect after
# a restart, and new app code that calls a new bridge route fails with a 404
# until then. We must NOT restart it inline: THIS script is a child of the
# bridge process (the bridge ran us via subprocess.run for POST /update), so an
# inline `systemctl restart` would kill us mid-update. Install the new file, then
# schedule a DETACHED restart a few seconds out so our JSON result reaches the UI
# first and the restart runs outside our (soon-to-be-killed) cgroup. Done before
# the Pi Hosted Docker branch below so both hosted and remote devices get it.
# Devices imaged before the kiosk unit gained its rotation ExecStartPost never
# re-apply the saved display rotation on boot: the unit file is written once at
# firstboot and no update path rewrites it, so the 2026-06-24 fix never reached
# already-deployed devices (FoodAssistant-prqg). The unit is generated with
# device-specific values, so it cannot be reinstalled from the repo like the
# bridge unit; instead the one missing line is patched in place.
KIOSK_UNIT="${KIOSK_UNIT:-/etc/systemd/system/foodassistant-kiosk.service}"
if [ -f "$KIOSK_UNIT" ] && ! grep -q "foodassistant-apply-rotation" "$KIOSK_UNIT"; then
  if sed -i '/^Restart=/i ExecStartPost=-/usr/local/bin/foodassistant-apply-rotation' "$KIOSK_UNIT" 2>/dev/null; then
    systemctl daemon-reload 2>/dev/null || true
    log "Patched $KIOSK_UNIT: saved rotation now re-applies on every kiosk start."
  else
    log "WARN: could not patch $KIOSK_UNIT for rotation re-apply."
  fi
fi

# Devices imaged before 2026-07-10 launch Chromium with --use-gl=egl. Newer
# Chromium (149+) rejects that value (it wants ANGLE: gl=egl-angle), so the GPU
# process exits during init and the kiosk falls back to software rendering
# (FoodAssistant-z29b). Swap the flag in place; the kiosk restart later in this
# run picks it up. Guarded on the old flag being present and no ANGLE flag yet,
# so it runs once.
if [ -f "$KIOSK_UNIT" ] && grep -q -- '--use-gl=egl' "$KIOSK_UNIT" \
    && ! grep -q -- '--use-angle=' "$KIOSK_UNIT"; then
  if sed -i 's/--use-gl=egl/--use-gl=angle --use-angle=gles-egl/' "$KIOSK_UNIT" 2>/dev/null; then
    systemctl daemon-reload 2>/dev/null || true
    log "Patched $KIOSK_UNIT: Chromium GPU uses ANGLE (was the rejected --use-gl=egl)."
  else
    log "WARN: could not patch $KIOSK_UNIT for the ANGLE GPU flag."
  fi
fi

# Devices imaged before 2026-07-10 launch Chromium without a dark default
# background, so every Stream Deck navigation (a full page load) flashed white
# before the app painted (FoodAssistant-9dhh). Add the flag in place; guarded
# on it being absent so it runs once.
if [ -f "$KIOSK_UNIT" ] && grep -q -- '--kiosk' "$KIOSK_UNIT" \
    && ! grep -q -- '--default-background-color=' "$KIOSK_UNIT"; then
  if sed -i 's/--kiosk --noerrdialogs/--kiosk --noerrdialogs --default-background-color=212529/' "$KIOSK_UNIT" 2>/dev/null \
      && grep -q -- '--default-background-color=' "$KIOSK_UNIT"; then
    systemctl daemon-reload 2>/dev/null || true
    log "Patched $KIOSK_UNIT: dark Chromium load background (no white flash between pages)."
  else
    log "WARN: could not patch $KIOSK_UNIT for the dark load background."
  fi
fi

# Escape hatch from external pages (FoodAssistant-wn8w). A tapped external
# link (an Amazon listing from the Shop page) fills the display with a site
# that has no way back: the kiosk browser is chromeless. Install or refresh
# the kiosk return extension (a floating return button plus a top-edge
# swipe-down on every page that is not the app itself) and load it in the
# deployed unit. Idempotent: the files are refreshed from the repo on every
# run, the app URL is re-baked from the unit's own ExecStart each time (the
# copy overwrites the previous bake), and the flags are added once. If the
# bake cannot be verified, any previously added flags are stripped so the
# kiosk never launches pointing at a broken extension.
KIOSK_EXT_DIR="${KIOSK_EXT_DIR:-/opt/foodassistant/kiosk-exit-extension}"
_ext_src="$SRC/scripts/image-build/kiosk-exit-extension"
if [ -f "$KIOSK_UNIT" ] && [ -f "$_ext_src/manifest.json" ]; then
  _ext_ok=0
  _ext_url="$(grep -oE 'https?://[^ "\\]+' "$KIOSK_UNIT" | tail -n1)"
  if [ -n "$_ext_url" ] && mkdir -p "$KIOSK_EXT_DIR" 2>/dev/null \
      && cp -f "$_ext_src"/* "$KIOSK_EXT_DIR"/ 2>/dev/null \
      && [ -f "$KIOSK_EXT_DIR/origin.js" ]; then
    _ext_esc="$(printf '%s' "$_ext_url" | sed -e 's/[\\&|]/\\&/g')"
    sed -i "s|__PR_KIOSK_HOME_URL__|$_ext_esc|" "$KIOSK_EXT_DIR/origin.js" 2>/dev/null || true
    grep -q "__PR_KIOSK_HOME_URL__" "$KIOSK_EXT_DIR/origin.js" || _ext_ok=1
  fi
  if [ "$_ext_ok" = "1" ]; then
    if ! grep -q -- '--load-extension=' "$KIOSK_UNIT"; then
      if sed -i "s|--kiosk --noerrdialogs|--kiosk --noerrdialogs --load-extension=$KIOSK_EXT_DIR --disable-extensions-except=$KIOSK_EXT_DIR|" "$KIOSK_UNIT" 2>/dev/null \
          && grep -q -- '--load-extension=' "$KIOSK_UNIT"; then
        systemctl daemon-reload 2>/dev/null || true
        log "Patched $KIOSK_UNIT: external pages now carry a return button and a top-edge swipe home."
      else
        log "WARN: could not patch $KIOSK_UNIT for the kiosk return extension."
      fi
    fi
  elif grep -q -- '--load-extension=' "$KIOSK_UNIT"; then
    if sed -i -E "s| --load-extension=[^ ]+ --disable-extensions-except=[^ ]+||" "$KIOSK_UNIT" 2>/dev/null; then
      systemctl daemon-reload 2>/dev/null || true
      log "WARN: kiosk return extension bake failed; removed its flags from $KIOSK_UNIT."
    fi
  else
    log "WARN: kiosk return extension not installed (bake failed or no kiosk URL in the unit)."
  fi
fi

# Devices imaged before the kiosk unit gained its boot hardening (seatd
# ordering, no start-limit give-up, a bounded wait for the app before the
# browser launches) still race seatd at boot and freeze on a Chromium
# connection-refused page when the kiosk beats the app up
# (FoodAssistant-9ext / FoodAssistant-kyl2). The unit is device-generated, so
# ship the additions as a drop-in rather than rewriting it. Skipped when the
# unit itself already carries the app wait (a fresh provision).
KIOSK_DROPIN_DIR="${KIOSK_DROPIN_DIR:-${KIOSK_UNIT}.d}"
_kdropin="$KIOSK_DROPIN_DIR/10-foodassistant-boot.conf"
if [ -f "$KIOSK_UNIT" ] && [ ! -f "$_kdropin" ] \
    && ! grep -q "command -v curl" "$KIOSK_UNIT"; then
  # The kiosk URL is the last http(s) argument of the unit's ExecStart. The
  # wait asks that origin's /health, not the kiosk page itself: a page fetch
  # from this device counts as a keyless local caller and would keep the
  # app's loopback trust from retiring.
  _kurl="$(grep -oE 'https?://[^ "\\]+' "$KIOSK_UNIT" | tail -n1)"
  if [ -n "$_kurl" ]; then
    _kurl="$(printf '%s' "$_kurl" | sed -E 's|^(https?://[^/?#]+).*|\1|')"
    # The origin lands inside a quoted shell command in the drop-in, so it
    # must be a plain scheme, host and port; anything else skips the wait.
    if printf '%s' "$_kurl" | grep -qE '^https?://[A-Za-z0-9._:-]+$|^https?://\[[0-9A-Fa-f:.]+\](:[0-9]+)?$'; then
      _kurl="$_kurl/health"
    else
      _kurl=""
    fi
  fi
  if mkdir -p "$KIOSK_DROPIN_DIR" 2>/dev/null; then
    {
      echo "[Unit]"
      echo "Wants=seatd.service"
      echo "After=seatd.service"
      echo "StartLimitIntervalSec=0"
      echo ""
      echo "[Service]"
      echo "TimeoutStartSec=240"
      if [ -n "$_kurl" ]; then
        echo "ExecStartPre=-/bin/sh -c 'command -v curl >/dev/null 2>&1 || exit 0; for i in \$\$(seq 1 40); do curl -sf -o /dev/null --max-time 2 \"$_kurl\" && exit 0; sleep 2; done; exit 0'"
      fi
    } > "$_kdropin" 2>/dev/null \
      && systemctl daemon-reload 2>/dev/null || true
    if [ -f "$_kdropin" ]; then
      log "Installed kiosk boot drop-in: seatd ordering, no start-limit give-up, app wait."
    else
      log "WARN: could not install the kiosk boot drop-in."
    fi
  else
    log "WARN: could not create $KIOSK_DROPIN_DIR for the kiosk boot drop-in."
  fi
fi

# Hide the kiosk cursor on deployed devices. Fresh provisions get a transparent
# XCursor theme plus Environment lines in the unit (firstboot), but devices
# imaged earlier never received them, and the old auto-detection kept the
# cursor whenever a pointer was attached at provision time, which misfired on
# USB barcode scanners (they enumerate a composite HID mouse). Deliver the
# theme and a drop-in here, honouring an explicit HIDE_CURSOR=false in
# config.env. Paths are env-overridable for tests.
CURSOR_THEME_DIR="${CURSOR_THEME_DIR:-/usr/share/icons/foodassistant-hidden}"
_hide_cursor_pref=""
for _cfg in /etc/foodassistant/config.env /boot/firmware/foodassistant.config.env /boot/foodassistant.config.env; do
  [ -f "$_cfg" ] || continue
  _v="$(grep -E '^ *(export +)?HIDE_CURSOR=' "$_cfg" 2>/dev/null | tail -n1 | sed 's/.*=//; s/["'"'"']//g')"
  [ -n "$_v" ] && _hide_cursor_pref="$_v"
done
_cdropin="$KIOSK_DROPIN_DIR/20-foodassistant-cursor.conf"
case "$_hide_cursor_pref" in
  false|FALSE|False|0|no|NO|No) : ;;  # explicit opt-out: leave the cursor alone
  *)
    if [ -f "$KIOSK_UNIT" ] && [ ! -f "$_cdropin" ] \
        && ! grep -q "XCURSOR_THEME" "$KIOSK_UNIT"; then
      mkdir -p "$CURSOR_THEME_DIR/cursors" 2>/dev/null || true
      if [ -d "$CURSOR_THEME_DIR/cursors" ]; then
        # A minimal valid single-image Xcursor whose only pixel is fully
        # transparent (same bytes firstboot writes; format: Xcursor(3)).
        printf '\130\143\165\162\020\000\000\000\000\000\001\000\001\000\000\000\002\000\375\377\001\000\000\000\034\000\000\000\044\000\000\000\002\000\375\377\001\000\000\000\001\000\000\000\001\000\000\000\001\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000' \
          > "$CURSOR_THEME_DIR/cursors/left_ptr" 2>/dev/null || true
        for _cn in default left_ptr_watch watch text xterm hand1 hand2 pointer \
                   top_left_arrow arrow crosshair fleur grabbing; do
          ln -sf left_ptr "$CURSOR_THEME_DIR/cursors/$_cn" 2>/dev/null || true
        done
        printf '[Icon Theme]\nName=FoodAssistant Hidden Cursor\nComment=Fully transparent cursor for touch/Stream Deck kiosks\n' \
          > "$CURSOR_THEME_DIR/index.theme" 2>/dev/null || true
      fi
      if [ -s "$CURSOR_THEME_DIR/cursors/left_ptr" ] && mkdir -p "$KIOSK_DROPIN_DIR" 2>/dev/null; then
        {
          echo "[Service]"
          echo "Environment=XCURSOR_PATH=$(dirname "$CURSOR_THEME_DIR")"
          echo "Environment=XCURSOR_THEME=$(basename "$CURSOR_THEME_DIR")"
          echo "Environment=XCURSOR_SIZE=24"
        } > "$_cdropin" 2>/dev/null \
          && systemctl daemon-reload 2>/dev/null || true
        if [ -f "$_cdropin" ]; then
          log "Installed the hidden-cursor theme and kiosk drop-in (HIDE_CURSOR=false in config.env restores the pointer)."
        else
          log "WARN: could not install the kiosk cursor drop-in."
        fi
      else
        log "WARN: could not write the hidden cursor theme."
      fi
    fi
    ;;
esac

# The vc4 HDMI CEC input devices advertise relative axes, which hands the
# Wayland seat a pointer and makes cage draw a cursor on mouse-less kiosks; no
# cursor theme or client CSS can remove a compositor seat cursor. Ignore the
# CEC devices for libinput on deployed devices (fresh provisions get the same
# rule from firstboot). A real mouse is unaffected. The kiosk restart later in
# this run makes it take effect.
CEC_RULES_FILE="${CEC_RULES_FILE:-/etc/udev/rules.d/71-foodassistant-cec-pointer.rules}"
if [ ! -f "$CEC_RULES_FILE" ] && mkdir -p "$(dirname "$CEC_RULES_FILE")" 2>/dev/null; then
  cat > "$CEC_RULES_FILE" 2>/dev/null <<'RULES'
# Pantry Raider kiosk: the vc4 HDMI CEC input devices expose relative axes,
# which makes the Wayland seat grow a pointer and the compositor draw a cursor
# even with no mouse attached. The kiosk does not use CEC input; ignore it.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="vc4-hdmi*", ENV{LIBINPUT_IGNORE_DEVICE}="1"
RULES
  if [ -f "$CEC_RULES_FILE" ]; then
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=input 2>/dev/null || true
    log "Installed the CEC pointer ignore rule; the compositor cursor goes away with the kiosk restart."
  else
    log "WARN: could not write $CEC_RULES_FILE"
  fi
fi

# Run a command with the partition holding FILE ($1) writable: remount it
# read-write first when it is mounted read-only, and read-only again after
# (the boot partition may be kept read-only against power loss).
_with_boot_rw() {
  local _f="$1" _mnt="" _opts="" _was_ro=0 _rc=0
  shift
  if command -v findmnt >/dev/null 2>&1; then
    _mnt="$(findmnt -n -o TARGET -T "$_f" 2>/dev/null || true)"
    _opts="$(findmnt -n -o OPTIONS -T "$_f" 2>/dev/null || true)"
  fi
  case ",$_opts," in
    *,ro,*) [ -n "$_mnt" ] && mount -o remount,rw "$_mnt" 2>/dev/null && _was_ro=1 ;;
  esac
  "$@" || _rc=$?
  if [ "$_was_ro" = "1" ]; then
    _sync
    mount -o remount,ro "$_mnt" 2>/dev/null || log "WARN: could not remount $_mnt read-only again."
  fi
  return $_rc
}

# Quiet the boot console on deployed kiosk devices. Fresh provisions get the
# kernel cmdline additions from firstboot's quiet_boot step, but devices imaged
# earlier still scroll kernel and systemd text on the attached display before
# the kiosk appears (FoodAssistant-go5e). Append any missing params to the
# single-line cmdline file; params already present, or a key an operator set to
# another value (say loglevel=7), are left alone, so re-runs never duplicate
# anything. console=tty1 stays untouched (the boot screen holds tty1 until the
# kiosk moves to its own VT) and tty2+ gettys remain available for debugging.
# Gated on the kiosk unit so headless boxes keep a verbose console. Paths are
# env-overridable for tests.
CMDLINE_CANDIDATES="${CMDLINE_CANDIDATES:-/boot/firmware/cmdline.txt /boot/cmdline.txt}"
_quiet_params="quiet loglevel=3 vt.global_cursor_default=0 logo.nologo consoleblank=0 rd.systemd.show_status=false systemd.show_status=false"
if [ -f "$KIOSK_UNIT" ]; then
  for _cmdline in $CMDLINE_CANDIDATES; do
    [ -f "$_cmdline" ] || continue
    _cline="$(tr -d '\n' < "$_cmdline")"
    _missing=""
    for _p in $_quiet_params; do
      _k="${_p%%=*}"
      if [ "$_p" = "$_k" ]; then
        case " $_cline " in *" $_p "*) continue ;; esac
      else
        case " $_cline " in *" $_k="*) continue ;; esac
      fi
      _missing="$_missing $_p"
    done
    _missing="${_missing# }"
    if [ -n "$_missing" ]; then
      if _with_boot_rw "$_cmdline" _atomic_write "$_cmdline" "$_cline $_missing
"; then
        log "Quieted the boot console in $_cmdline (added: $_missing); takes effect after the next reboot."
      else
        log "WARN: could not update $_cmdline to quiet the boot console."
      fi
    fi
    break
  done
fi

# The kiosk on its own VT (FoodAssistant-y8vj). Units written before the
# animated boot screen run cage on tty1 with Conflicts=getty@tty1. seatd hands
# cage whichever VT is on screen, and the unit's terminal reset of tty1 at
# every ExecStartPre switches tty1 back to text mode, so the console showed
# through the boot screen. Move the kiosk to tty7 and switch there just
# before cage starts (a drop-in, so it runs after any older drop-in's app
# wait). getty@tty1 no longer needs the Conflicts=: its own drop-in keeps it
# off on a kiosk device, and without the Conflicts= a VT switch to tty1 can
# never stop the kiosk. daemon-reload only: the running kiosk moves VT at its
# next start (the restart later in this run, or the next boot).
_kvt_dropin="$KIOSK_DROPIN_DIR/30-foodassistant-vt.conf"
if [ -f "$KIOSK_UNIT" ]; then
  _kvt_changed=0
  if grep -qE '^Conflicts=getty@tty1\.service$|^After=.* getty@tty1\.service' "$KIOSK_UNIT"; then
    if sed -i -e '/^Conflicts=getty@tty1\.service$/d' \
        -e '/^After=/s/ getty@tty1\.service//' "$KIOSK_UNIT" 2>/dev/null; then
      _kvt_changed=1
      log "Patched $KIOSK_UNIT: the kiosk no longer conflicts with the tty1 console."
    else
      log "WARN: could not patch $KIOSK_UNIT to drop its getty@tty1 conflict."
    fi
  fi
  # grep -q exits 0 on a match even when the glob names no file.
  if ! grep -qsE '^ExecStartPre=.*chvt [0-9]' "$KIOSK_UNIT" "$KIOSK_DROPIN_DIR"/*.conf; then
    if mkdir -p "$KIOSK_DROPIN_DIR" 2>/dev/null && {
        echo "# The kiosk on its own VT: switch there once the app answers, just"
        echo "# before cage starts (seatd hands cage the VT on screen). The boot"
        echo "# screen on tty1 lets go on this switch. Root (+), never fatal (-)."
        echo "[Service]"
        echo "TTYPath=/dev/tty7"
        echo "UtmpIdentifier=tty7"
        echo "ExecStartPre=-+/usr/bin/timeout 10 /usr/bin/chvt 7"
      } > "$_kvt_dropin" 2>/dev/null; then
      _kvt_changed=1
      log "Installed the kiosk VT drop-in: the kiosk runs on its own VT from its next start."
    else
      log "WARN: could not install the kiosk VT drop-in."
    fi
  fi
  if [ "$_kvt_changed" = "1" ]; then
    systemctl daemon-reload 2>/dev/null || true
  fi
fi

# Animated boot screen (FoodAssistant-y8vj). Fresh provisions install it from
# firstboot's fb_splash step; this installs or refreshes it on deployed kiosk
# devices: the artwork, the unit, the getty@tty1 drop-in that keeps the
# console's reset off the animation, and disable_splash=1 in config.txt. The
# screen script itself reaches BIN_DIR via the generic helper sync above.
# Gated on the kiosk unit (a headless box has no display), skipped when
# config.env says ENABLE_FB_SPLASH=false, and fail-safe at boot: the script
# skips itself when anything is missing, so the worst case stays the plain
# quiet boot. Paths are env-overridable for tests.
SPLASH_UNIT="${SPLASH_UNIT:-/etc/systemd/system/foodassistant-boot-splash.service}"
SPLASH_ASSET_DIR="${SPLASH_ASSET_DIR:-/opt/foodassistant/boot-splash}"
GETTY_DROPIN="${GETTY_DROPIN:-/etc/systemd/system/getty@tty1.service.d/10-foodassistant-boot-splash.conf}"
CONFIG_TXT_CANDIDATES="${CONFIG_TXT_CANDIDATES:-/boot/firmware/config.txt /boot/config.txt}"
_spu_src="$SRC/scripts/image-build/foodassistant-boot-splash.service"
_spa_src="$SRC/scripts/image-build/boot-splash/splash-art.gz"
_spg_src="$SRC/scripts/image-build/boot-splash/getty-tty1.conf"
_fb_splash_pref=""
for _cfg in /etc/foodassistant/config.env /boot/firmware/foodassistant.config.env /boot/foodassistant.config.env; do
  [ -f "$_cfg" ] || continue
  _v="$(grep -E '^ *(export +)?ENABLE_FB_SPLASH=' "$_cfg" 2>/dev/null | tail -n1 | sed 's/.*=//; s/["'"'"']//g')"
  [ -n "$_v" ] && _fb_splash_pref="$_v"
done
case "$_fb_splash_pref" in
  false|FALSE|False|0|no|NO|No) _fb_splash_on=0 ;;
  *) _fb_splash_on=1 ;;
esac
_append_boot_screen_block() {
  local _body
  _body="$(cat "$1")" || return 1
  _atomic_write "$1" "$_body
# BEGIN Pantry Raider boot screen
[all]
disable_splash=1
# END Pantry Raider boot screen
"
}
if [ "$_fb_splash_on" = "1" ] && [ -f "$KIOSK_UNIT" ] && [ -f "$_spu_src" ] \
    && [ -f "$_spa_src" ] && [ -f "$_spg_src" ]; then
  _sp_reload=0
  if ! cmp -s "$_spa_src" "$SPLASH_ASSET_DIR/splash-art.gz"; then
    mkdir -p "$SPLASH_ASSET_DIR" 2>/dev/null || true
    if install -m 644 "$_spa_src" "$SPLASH_ASSET_DIR/splash-art.gz" 2>/dev/null; then
      log "Refreshed the boot screen artwork."
    else
      log "WARN: could not install the boot screen artwork."
    fi
  fi
  # The still image of the earlier boot splash.
  rm -f "$SPLASH_ASSET_DIR/splash.ppm.gz" 2>/dev/null || true
  if ! cmp -s "$_spg_src" "$GETTY_DROPIN"; then
    mkdir -p "$(dirname "$GETTY_DROPIN")" 2>/dev/null || true
    if install -m 644 "$_spg_src" "$GETTY_DROPIN" 2>/dev/null; then
      _sp_reload=1
      log "Ordered the tty1 console after the boot screen."
    else
      log "WARN: could not install $GETTY_DROPIN."
    fi
  fi
  if ! cmp -s "$_spu_src" "$SPLASH_UNIT"; then
    if install -m 644 "$_spu_src" "$SPLASH_UNIT" 2>/dev/null; then
      _sp_reload=1
      log "Installed the boot splash: the animated Pantry Raider screen shows during boot from the next restart."
    else
      log "WARN: could not install the boot splash unit."
    fi
  fi
  if [ "$_sp_reload" = "1" ]; then
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable foodassistant-boot-splash.service >/dev/null 2>&1 || true
  fi
  for _cfgtxt in $CONFIG_TXT_CANDIDATES; do
    [ -f "$_cfgtxt" ] || continue
    if ! grep -qE '^[[:space:]]*disable_splash=' "$_cfgtxt"; then
      if _with_boot_rw "$_cfgtxt" _append_boot_screen_block "$_cfgtxt"; then
        log "Turned off the firmware colour splash in $_cfgtxt; takes effect after the next reboot."
      else
        log "WARN: could not update $_cfgtxt."
      fi
    fi
    break
  done
elif [ "$_fb_splash_on" = "0" ] && [ -f "$SPLASH_UNIT" ] \
    && systemctl is-enabled --quiet foodassistant-boot-splash.service 2>/dev/null; then
  systemctl disable foodassistant-boot-splash.service >/dev/null 2>&1 || true
  log "Turned off the boot screen (ENABLE_FB_SPLASH=false in config.env)."
fi

# Kiosk devices imaged before firstboot installed a colour emoji font render
# every emoji in the UI as an empty box (Chromium under cage has no desktop
# font stack to fall back on; FoodAssistant-438t). Fresh provisions get
# fonts-noto-color-emoji at firstboot; retrofit it here. Gated on the kiosk
# unit (headless boxes skip it) and the package being absent, best-effort and
# time-bounded so an offline device never stalls or fails the update. The
# kiosk restart later in this run makes the font take effect.
if [ -f "$KIOSK_UNIT" ] && command -v dpkg-query >/dev/null 2>&1 \
    && ! dpkg-query -W -f='${Status}' fonts-noto-color-emoji 2>/dev/null \
       | grep -q "install ok installed"; then
  if DEBIAN_FRONTEND=noninteractive timeout 120 apt-get install -y \
      --no-install-recommends fonts-noto-color-emoji >/dev/null 2>&1; then
    log "Installed fonts-noto-color-emoji; emoji show after the kiosk restarts."
  elif DEBIAN_FRONTEND=noninteractive timeout 120 apt-get update >/dev/null 2>&1 \
      && DEBIAN_FRONTEND=noninteractive timeout 120 apt-get install -y \
         --no-install-recommends fonts-noto-color-emoji >/dev/null 2>&1; then
    log "Installed fonts-noto-color-emoji (after an apt update); emoji show after the kiosk restarts."
  else
    log "WARN: could not install fonts-noto-color-emoji (offline?); emoji stay as boxes until a later update."
  fi
fi

# The two package retrofits below serve the Pi appliance (the host bridge
# runs them). An install.sh server says deployment_mode "server" in its
# settings (read the way firstboot reads it) and skips them; an empty or
# unreadable settings file keeps the retrofits.
_deploy_mode=""
if [ -r "$SETTINGS_JSON" ]; then
  _deploy_mode="$(grep -o '"deployment_mode"[[:space:]]*:[[:space:]]*"[^"]*"' "$SETTINGS_JSON" 2>/dev/null \
    | head -n1 | sed 's/.*"\([^"]*\)"$/\1/' || true)"
fi
_appliance_pkgs=1
if [ "$_deploy_mode" = "server" ]; then
  _appliance_pkgs=0
  log "Server install: skipping the appliance-only packages (wireguard-tools, libheif-examples)."
fi

# WireGuard tools power Forager remote access (the bridge runs wg/wg-quick on
# the host). Fresh provisions install them at firstboot; retrofit existing
# devices here so turning on remote access does not fail with "could not set
# up remote access". Best-effort and time-bounded, like the font retrofit.
if [ "$_appliance_pkgs" = "1" ] && command -v dpkg-query >/dev/null 2>&1 \
    && ! dpkg-query -W -f='${Status}' wireguard-tools 2>/dev/null \
       | grep -q "install ok installed"; then
  if DEBIAN_FRONTEND=noninteractive timeout 120 apt-get install -y \
      --no-install-recommends wireguard-tools >/dev/null 2>&1; then
    log "Installed wireguard-tools; Forager remote access can now be turned on."
  elif DEBIAN_FRONTEND=noninteractive timeout 120 apt-get update >/dev/null 2>&1 \
      && DEBIAN_FRONTEND=noninteractive timeout 120 apt-get install -y \
         --no-install-recommends wireguard-tools >/dev/null 2>&1; then
    log "Installed wireguard-tools (after an apt update); Forager remote access can now be turned on."
  else
    log "WARN: could not install wireguard-tools (offline?); Forager remote access stays unavailable until a later update."
  fi
fi

# libheif-examples provides heif-convert, which the host bridge uses to
# transcode iPhone HEIC/HEIF photos on a USB drive to JPEG for the screensaver
# slideshow (browsers cannot render HEIC natively). Fresh provisions install it
# at firstboot; retrofit existing devices here so HEIC photos start showing.
# Best-effort and time-bounded, like the font and WireGuard retrofits; without
# it HEIC photos are simply skipped and other formats still show.
if [ "$_appliance_pkgs" = "1" ] && command -v dpkg-query >/dev/null 2>&1 \
    && ! dpkg-query -W -f='${Status}' libheif-examples 2>/dev/null \
       | grep -q "install ok installed"; then
  if DEBIAN_FRONTEND=noninteractive timeout 120 apt-get install -y \
      --no-install-recommends libheif-examples >/dev/null 2>&1; then
    log "Installed libheif-examples; iPhone HEIC photos now show in the slideshow."
  elif DEBIAN_FRONTEND=noninteractive timeout 120 apt-get update >/dev/null 2>&1 \
      && DEBIAN_FRONTEND=noninteractive timeout 120 apt-get install -y \
         --no-install-recommends libheif-examples >/dev/null 2>&1; then
    log "Installed libheif-examples (after an apt update); iPhone HEIC photos now show in the slideshow."
  else
    log "WARN: could not install libheif-examples (offline?); HEIC photos stay skipped until a later update."
  fi
fi

# Keep the Wi-Fi fallback AP watchdog current too. The generic sync above
# installs the repo copy under BIN_DIR like any other helper, but the watchdog
# unit written at firstboot executes /usr/local/sbin/foodassistant-ap-watchdog,
# so that copy must be refreshed separately or deployed devices keep running
# the version they were imaged with (FoodAssistant-fuat). Gated on the unit
# file so a device without the AP fallback never grows a stray sbin script.
#
# The unit itself is refreshed here as well: the watchdog became a continuous
# loop (the hotspot rises whenever the network is lost, not just at boot), and
# the unit had to move from Type=oneshot to a plain always-restarted service
# with it. A deployed device that kept the old oneshot unit would run the loop
# once at boot and never again, so when either file changed the service is
# restarted so the loop takes over immediately.
AP_WATCHDOG_UNIT="${AP_WATCHDOG_UNIT:-/etc/systemd/system/foodassistant-ap-watchdog.service}"
_wsrc="$SRC/scripts/image-build/foodassistant-ap-watchdog"
_wusrc="$SRC/scripts/image-build/foodassistant-ap-watchdog.service"
_wchanged=0
if [ -f "$AP_WATCHDOG_UNIT" ] && [ -f "$_wsrc" ] \
    && ! cmp -s "$_wsrc" "$SBIN_DIR/foodassistant-ap-watchdog"; then
  if install -m 755 "$_wsrc" "$SBIN_DIR/foodassistant-ap-watchdog" 2>/dev/null; then
    log "Refreshed $SBIN_DIR/foodassistant-ap-watchdog (AP fallback watchdog)"
    _wchanged=1
  else
    log "WARN: could not refresh $SBIN_DIR/foodassistant-ap-watchdog"
  fi
fi
if [ -f "$AP_WATCHDOG_UNIT" ] && [ -f "$_wusrc" ] \
    && ! cmp -s "$_wusrc" "$AP_WATCHDOG_UNIT"; then
  if install -m 644 "$_wusrc" "$AP_WATCHDOG_UNIT" 2>/dev/null; then
    systemctl daemon-reload 2>/dev/null || true
    log "Refreshed the AP watchdog unit (continuous recovery-hotspot watchdog)"
    _wchanged=1
  else
    log "WARN: could not refresh the AP watchdog unit"
  fi
fi
if [ "$_wchanged" = "1" ]; then
  systemctl restart foodassistant-ap-watchdog.service >/dev/null 2>&1 || true
fi

# Recovery hotspot services on deployed devices. Debian's hostapd package masks
# hostapd.service when it is installed before its config exists, which is how
# first boot used to install it, so on those devices 'systemctl start hostapd'
# fails and the hotspot never comes up when the network is lost. apt also
# enabled both services at boot, which left dnsmasq answering DNS on the home
# network with every name pointed at the hotspot address. Unmask hostapd, keep
# both off at boot (the watchdog and the host bridge start them on demand), and
# bind dnsmasq to the hotspot interface alone. Gated on the Pantry Raider
# hotspot config, so a device without the hotspot, or a machine running its
# own dnsmasq, is left alone. Runs on both Pi shapes (this sits before the Pi
# Hosted branch exits); every step is idempotent and none can fail the update.
HOSTAPD_CONF="${HOSTAPD_CONF:-/etc/hostapd/hostapd.conf}"
AP_DNSMASQ_CONF="${AP_DNSMASQ_CONF:-/etc/dnsmasq.d/foodassistant-ap.conf}"
AP_FLAG="${AP_FLAG:-/run/foodassistant-ap-active}"
if [ -f "$AP_DNSMASQ_CONF" ]; then
  if ! grep -q '^bind-interfaces' "$AP_DNSMASQ_CONF" 2>/dev/null; then
    if printf 'bind-interfaces\nexcept-interface=lo\n' >> "$AP_DNSMASQ_CONF" 2>/dev/null; then
      log "Bound the hotspot's dnsmasq to the hotspot interface only."
      if [ -e "$AP_FLAG" ]; then
        systemctl try-restart dnsmasq.service >/dev/null 2>&1 || true
      fi
    else
      log "WARN: could not update $AP_DNSMASQ_CONF."
    fi
  fi
  if [ -f "$HOSTAPD_CONF" ] \
      && [ "$(systemctl is-enabled hostapd.service 2>/dev/null)" = "masked" ]; then
    if systemctl unmask hostapd.service >/dev/null 2>&1; then
      log "Unmasked hostapd so the recovery hotspot can start when the network is lost."
    else
      log "WARN: could not unmask hostapd; the recovery hotspot may not start."
    fi
  fi
  if [ ! -e "$AP_FLAG" ]; then
    for _apsvc in hostapd.service dnsmasq.service; do
      if [ "$(systemctl is-enabled "$_apsvc" 2>/dev/null)" = "enabled" ]; then
        if systemctl disable "$_apsvc" >/dev/null 2>&1; then
          log "Turned off $_apsvc at boot; it starts only while the recovery hotspot is up."
        else
          log "WARN: could not turn off $_apsvc at boot."
        fi
      fi
    done
    if systemctl is-active --quiet dnsmasq.service 2>/dev/null; then
      if systemctl stop dnsmasq.service >/dev/null 2>&1; then
        log "Stopped dnsmasq; the recovery hotspot is not up."
      else
        log "WARN: could not stop dnsmasq."
      fi
    fi
  fi
fi

# Port 80 redirect on deployed Pi Hosted devices. The boot unit first boot used
# to write redirected ALL port-80 traffic passing through PREROUTING to the app,
# including what the Grocy, Mealie, and Ollama containers send out to the
# internet, so a container fetching an http:// page got Pantry Raider instead.
# Rewrite the unit to match only traffic addressed to this device, drop the
# live unscoped rule, and re-run the unit. Guarded on the old rule being in the
# unit, so it runs once. Paths are env-overridable for tests.
PORT80_UNIT="${PORT80_UNIT:-/etc/systemd/system/foodassistant-port80.service}"
# Keep in step with port80_unit_text in firstboot.sh; the tests compare them.
port80_unit_text() {
  cat <<'EOF'
[Unit]
Description=FoodAssistant port 80 -> 9284 redirect (pi_hosted)
After=network-pre.target
Wants=network-pre.target
Before=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Idempotent: drop any old unscoped rule, then add each scoped rule only if it
# is not already present. PREROUTING matches only traffic addressed to this
# device, so containers' outbound HTTP is never redirected.
ExecStart=/bin/sh -c 'while iptables -t nat -D PREROUTING -p tcp --dport 80 -j REDIRECT --to-port 9284 2>/dev/null; do :; done; iptables -t nat -C PREROUTING -p tcp -m addrtype --dst-type LOCAL --dport 80 -j REDIRECT --to-port 9284 2>/dev/null || iptables -t nat -A PREROUTING -p tcp -m addrtype --dst-type LOCAL --dport 80 -j REDIRECT --to-port 9284'
ExecStart=/bin/sh -c 'iptables -t nat -D OUTPUT -p tcp --dport 80 -j REDIRECT --to-port 9284 2>/dev/null; iptables -t nat -C OUTPUT -o lo -p tcp --dport 80 -j REDIRECT --to-port 9284 2>/dev/null || iptables -t nat -A OUTPUT -o lo -p tcp --dport 80 -j REDIRECT --to-port 9284'

[Install]
WantedBy=multi-user.target
EOF
}
if [ -f "$PORT80_UNIT" ] \
    && grep -E '^ExecStart=.*PREROUTING' "$PORT80_UNIT" 2>/dev/null | grep -qv 'addrtype'; then
  if _atomic_write "$PORT80_UNIT" "$(port80_unit_text)
" 2>/dev/null; then
    systemctl daemon-reload 2>/dev/null || true
    if command -v iptables >/dev/null 2>&1; then
      while iptables -t nat -D PREROUTING -p tcp --dport 80 -j REDIRECT --to-port 9284 2>/dev/null; do :; done
    fi
    if systemctl restart foodassistant-port80.service >/dev/null 2>&1; then
      log "Port 80 now redirects only traffic addressed to this device; containers reach the internet over plain HTTP again."
    else
      log "WARN: rewrote $PORT80_UNIT but could not restart it; the redirect applies after the next reboot."
    fi
    # iptables-persistent restores its saved rules at boot; save the fixed set
    # so the old rule does not come back from there.
    if command -v netfilter-persistent >/dev/null 2>&1; then
      netfilter-persistent save >/dev/null 2>&1 || true
    fi
  else
    log "WARN: could not rewrite $PORT80_UNIT; port 80 still redirects container traffic."
  fi
fi

_bsrc="$SRC/scripts/image-build/foodassistant-host-bridge"
_bdst="$BIN_DIR/foodassistant-host-bridge"
if [ -f "$_bsrc" ]; then
  _bs="$(sha1sum "$_bsrc" 2>/dev/null | cut -d' ' -f1)"
  _bd="$(sha1sum "$_bdst" 2>/dev/null | cut -d' ' -f1)"
  if [ "$_bs" != "$_bd" ] && install -m 755 "$_bsrc" "$_bdst" 2>/dev/null; then
    log "Refreshed $_bdst (host bridge); scheduling a detached restart"
    # Refresh the unit file too if it changed, then reload systemd.
    _bsvc="$SRC/scripts/image-build/foodassistant-host-bridge.service"
    if [ -f "$_bsvc" ] && ! cmp -s "$_bsvc" /etc/systemd/system/foodassistant-host-bridge.service; then
      install -m 644 "$_bsvc" /etc/systemd/system/foodassistant-host-bridge.service 2>/dev/null \
        && systemctl daemon-reload 2>/dev/null || true
    fi
    # Scheduled on the way out (see _result), not here: this run still has
    # the app to swap and to watch come up, and a bridge restart takes this
    # run down with it.
    BRIDGE_RESTART_PENDING=1
  elif [ "$_bs" = "$_bd" ]; then
    log "Host bridge unchanged; no restart needed."
  fi
fi

INSTALL_DIR="${INSTALL_DIR:-/opt/foodassistant}"

# Re-assert the optional label print stack when it was previously enabled
# (FoodAssistant-gyri). A user who turned printing on has PRINTING_ENABLED=1 in
# the stack .env; an OS package prune, a reflash, or a cupsd config reset could
# otherwise silently break printing after an update. The generic helper sync
# above already installed foodassistant-print-setup into BIN_DIR, so re-run it:
# it is idempotent and quick when everything is already in place, and it keeps
# CUPS_SERVER current in the .env. GUARDED on the marker, so a device that never
# enabled printing (the default, including Dan's server) never installs CUPS.
_PRINT_ENV_FILE="${PRINT_ENV_FILE:-$INSTALL_DIR/.env}"
if [ -f "$_PRINT_ENV_FILE" ] \
    && grep -qiE '^PRINTING_ENABLED=(1|true|yes|on)' "$_PRINT_ENV_FILE" 2>/dev/null; then
  if [ -x "$BIN_DIR/foodassistant-print-setup" ]; then
    log "Printing was enabled; re-asserting the print stack."
    if INSTALL_DIR="$INSTALL_DIR" "$BIN_DIR/foodassistant-print-setup" >/dev/null 2>&1; then
      log "Print stack re-asserted."
    else
      log "WARN: print stack re-assert reported problems; printing may need attention in Settings."
    fi
  else
    log "Printing was enabled but foodassistant-print-setup is not installed; skipping re-assert."
  fi
fi

# --- I2C bus for plug-in accessories (FoodAssistant-9nybq) -------------------
# A fresh flash turns the I2C bus on at first boot (firstboot's configure_i2c,
# FoodAssistant-dxr22), but first boot never re-runs, so a device imaged before
# that step existed updates to a build that drives the NeoKey pad and still has
# no bus: no dtparam, no i2c-dev module, no i2cdetect, and a service user that
# cannot open the device node. Re-assert the whole set on every update, on both
# Pi shapes (this sits before the Pi Hosted branch exits). The four steps are
# the block foodassistant-gadgets-setup carries, duplicated because that helper
# is a one-shot opt-in installer this script must not run uninvited; keep the
# two in step. Every step is idempotent, so a device that already has the bus
# does nothing but a few greps. Gated on a Pi boot config being present, which
# is what keeps it off a plain server. Paths and tool names are env-overridable
# for tests.
I2C_CONFIG_CANDIDATES="${I2C_CONFIG_CANDIDATES:-/boot/firmware/config.txt /boot/config.txt}"
I2C_MODULES_DIR="${I2C_MODULES_DIR:-/etc/modules-load.d}"
I2C_TOOL="${I2C_TOOL:-i2cdetect}"
I2C_DEV="${I2C_DEV:-/dev/i2c-1}"
SETTINGS_JSON="${SETTINGS_JSON:-$INSTALL_DIR/data/settings.json}"
reboot_needed=0
_i2c_cfg=""
for _c in $I2C_CONFIG_CANDIDATES; do
  if [ -f "$_c" ]; then _i2c_cfg="$_c"; break; fi
done
if [ -n "$_i2c_cfg" ]; then
  if ! grep -qE '^dtparam=i2c_arm=on' "$_i2c_cfg" 2>/dev/null; then
    # raspi-config is the supported way to set the parameter (it also fixes a
    # commented-out or "off" line in place); the plain append covers a Pi
    # without it, or one where it refuses.
    if command -v raspi-config >/dev/null 2>&1; then
      raspi-config nonint do_i2c 0 >/dev/null 2>&1 || true
    fi
    if ! grep -qE '^dtparam=i2c_arm=on' "$_i2c_cfg" 2>/dev/null; then
      printf 'dtparam=i2c_arm=on\n' >> "$_i2c_cfg" 2>/dev/null || true
    fi
    if grep -qE '^dtparam=i2c_arm=on' "$_i2c_cfg" 2>/dev/null; then
      reboot_needed=1
      log "Turned the I2C bus on for plug-in accessories ($_i2c_cfg). REBOOT NEEDED: the bus appears after the next restart, and a plugged-in pad works from then on."
    else
      log "WARN: could not turn the I2C bus on in $_i2c_cfg; plug-in accessories stay unavailable."
    fi
  fi
  # Load the module now so a bus that is already on works without a reboot,
  # and on every boot from here on.
  modprobe i2c-dev >/dev/null 2>&1 || true
  if [ -d "$I2C_MODULES_DIR" ] && [ ! -f "$I2C_MODULES_DIR/foodassistant-i2c.conf" ]; then
    if printf 'i2c-dev\n' > "$I2C_MODULES_DIR/foodassistant-i2c.conf" 2>/dev/null; then
      log "Set the i2c-dev module to load at boot."
    else
      log "WARN: could not write $I2C_MODULES_DIR/foodassistant-i2c.conf."
    fi
  fi
  # i2cdetect is how a plugged-in accessory is found (below, and by a person
  # at a shell). Best-effort and time-bounded, like the other package
  # retrofits: offline, the detection simply waits for a later update.
  if ! command -v "$I2C_TOOL" >/dev/null 2>&1; then
    if DEBIAN_FRONTEND=noninteractive timeout 120 apt-get install -y \
        --no-install-recommends i2c-tools >/dev/null 2>&1; then
      log "Installed i2c-tools; plug-in accessories can now be detected."
    else
      log "WARN: could not install i2c-tools (offline?); plug-in accessories cannot be detected until a later update."
    fi
  fi
  # The reader needs the i2c group to open the device node; new membership
  # applies when its service next restarts.
  _i2c_user="${GD_USER:-$(_service_user)}"
  if [ -z "$_i2c_user" ]; then _i2c_user="foodassistant"; fi
  if getent group i2c >/dev/null 2>&1 \
      && ! id -nG "$_i2c_user" 2>/dev/null | tr ' ' '\n' | grep -qx i2c; then
    if usermod -aG i2c "$_i2c_user" >/dev/null 2>&1; then
      log "Added $_i2c_user to the i2c group so the reader can use plug-in accessories."
    else
      log "WARN: could not add $_i2c_user to the i2c group."
    fi
  fi

  # Install the reader when there is an accessory for it to drive, exactly as
  # the Settings pane's Set up for me button does (the bridge runs this same
  # helper). Only when ENABLE_GADGETS resolves to auto (unset or "auto" in
  # config.env: "false" is an opt-out, "true" installed it at first boot), the
  # reader is not installed yet, and either a board answers at a NeoKey
  # address on the bus right now or the app already has one registered (a
  # device whose bus was just turned on cannot answer until it reboots, but
  # its registry says what is plugged in). Anything less leaves the device as
  # it was: a normal update never grows the reader onto a box uninvited.
  _gadgets_pref=""
  for _cfg in /etc/foodassistant/config.env /boot/firmware/foodassistant.config.env /boot/foodassistant.config.env; do
    [ -f "$_cfg" ] || continue
    _v="$(grep -E '^ *(export +)?ENABLE_GADGETS=' "$_cfg" 2>/dev/null | tail -n1 | sed 's/.*=//; s/["'"'"']//g')"
    [ -n "$_v" ] && _gadgets_pref="$_v"
  done
  _gadgets_pref="${ENABLE_GADGETS:-$_gadgets_pref}"
  case "$_gadgets_pref" in
    ""|auto|AUTO|Auto) _gadgets_auto=1 ;;
    *) _gadgets_auto=0 ;;
  esac
  _accessory_present=0
  if [ -e "$I2C_DEV" ] && command -v "$I2C_TOOL" >/dev/null 2>&1 \
      && "$I2C_TOOL" -y 1 2>/dev/null \
         | awk 'NR > 1 { for (i = 2; i <= NF; i++) if ($i ~ /^(30|31|32|33)$/) found = 1 } END { exit !found }'; then
    _accessory_present=1
  elif [ -f "$SETTINGS_JSON" ] && python3 - "$SETTINGS_JSON" <<'PY' 2>/dev/null
import json, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
devices = data.get("stemma_devices") if isinstance(data, dict) else None
sys.exit(0 if isinstance(devices, list) and devices else 1)
PY
  then
    _accessory_present=1
  fi
  if [ "$_gadgets_auto" = "1" ] && [ "$_accessory_present" = "1" ] && [ ! -d "$GD_DST" ]; then
    if [ -x "$BIN_DIR/foodassistant-gadgets-setup" ]; then
      log "A plug-in accessory is here and the reader is not set up yet; setting it up now."
      if INSTALL_DIR="$INSTALL_DIR" REPO_DIR="$SRC" timeout 600 "$BIN_DIR/foodassistant-gadgets-setup" >/dev/null 2>&1; then
        log "The accessory reader is set up; a plugged-in pad works once the bus is up."
      else
        log "WARN: the accessory reader could not be set up; use Set up for me in Settings, Thermometers & Sensors, Accessories."
      fi
    else
      log "A plug-in accessory is here but foodassistant-gadgets-setup is not installed; use Set up for me in Settings."
    fi
  fi
fi

# --- Did the new version start? ------------------------------------------------
# After the app is swapped, the run waits for it to answer /health as Pantry
# Raider (and, where the version is known for sure, as the version just
# installed). When it never does, the version that ran before goes back and
# the run ends with a hold that says why. Both waits come out of the host
# bridge's 600 second limit on the whole run (UPDATE_BUDGET, a little under
# it), so a slow pull leaves a shorter first wait rather than a run the bridge
# kills halfway through a switch back. FA_HEALTH_TIMEOUT=0 skips the check.
HEALTH_TIMEOUT="${FA_HEALTH_TIMEOUT:-180}"
HEALTH_ROLLBACK_TIMEOUT="${FA_HEALTH_ROLLBACK_TIMEOUT:-120}"
[[ "$HEALTH_TIMEOUT" =~ ^[0-9]+$ ]] || HEALTH_TIMEOUT=180
[[ "$HEALTH_ROLLBACK_TIMEOUT" =~ ^[0-9]+$ ]] || HEALTH_ROLLBACK_TIMEOUT=120
HEALTH_SEEN=""
HEALTH_WAITED=0

# Where the app answers: the hosted container listens on 9284 on the host
# network; a venv install on the --port its unit starts uvicorn with (80 on
# a Pi Remote).
_health_url() {
  local port=""
  if [ -n "${FA_HEALTH_URL:-}" ]; then
    printf '%s' "$FA_HEALTH_URL"; return 0
  fi
  if [ "$1" = "docker" ]; then
    printf '%s' "http://127.0.0.1:9284/health"; return 0
  fi
  port="$(grep -m1 -oE -- '--port[= ]+[0-9]+' "${UNIT_DIR:-/etc/systemd/system}/$SERVICE" 2>/dev/null \
    | grep -oE '[0-9]+$')"
  printf 'http://127.0.0.1:%s/health' "${port:-80}"
}

# Seconds left before the bridge's limit on this run.
_budget_left() { echo $(( UPDATE_BUDGET - ($(date +%s) - RUN_STARTED_AT) )); }

# How long to wait: CAP seconds at most, less when the budget is short (keeping
# RESERVE seconds back), but never under FLOOR seconds (or CAP, if smaller).
_wait_for() {
  local cap="$1" reserve="$2" floor="$3" w
  w=$(( $(_budget_left) - reserve ))
  [ "$w" -gt "$cap" ] && w="$cap"
  [ "$w" -lt "$floor" ] && w="$floor"
  [ "$w" -gt "$cap" ] && w="$cap"
  echo "$w"
}

# _wait_healthy URL SECONDS [VERSION]: poll URL until it answers as Pantry
# Raider (as VERSION, when one is given) or SECONDS pass. One python3 process
# for the whole wait. Returns 0 once it answers; HEALTH_SEEN holds the version
# that last answered (empty when nothing did) and HEALTH_WAITED the wait.
_wait_healthy() {
  local out
  HEALTH_WAITED="$2"
  out="$(python3 -c '
import json, sys, time, urllib.request
url, limit, want = sys.argv[1], float(sys.argv[2]), sys.argv[3]
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
deadline = time.monotonic() + limit
seen = ""
while True:
    left = deadline - time.monotonic()
    try:
        with opener.open(url, timeout=max(2.0, min(10.0, left + 1))) as r:
            d = json.loads(r.read(65536).decode("utf-8", "replace"))
        if isinstance(d, dict) and d.get("app") == "foodassistant":
            v = str(d.get("version", ""))
            if not want or v == want:
                print("ok " + v)
                sys.exit(0)
            seen = v
    except Exception:
        pass
    left = deadline - time.monotonic()
    if left <= 0:
        break
    time.sleep(min(3.0, left))
print("no " + seen)
' "$1" "$2" "${3:-}" 2>/dev/null)"
  HEALTH_SEEN="${out#* }"
  [ "$out" = "${out#* }" ] && HEALTH_SEEN=""
  [ "${out%% *}" = "ok" ]
}

# Why the new version counts as not started, for the hold.
_not_started_why() {
  local label="Pantry Raider ${target_ver:-}"
  label="${label% }"
  if [ -n "$HEALTH_SEEN" ] && [ -n "${1:-}" ] && [ "$HEALTH_SEEN" != "$1" ]; then
    printf '%s' "$label was installed, but version $HEALTH_SEEN answered instead"
  else
    if [ "$HEALTH_WAITED" -ge 120 ] && [ $((HEALTH_WAITED % 60)) -eq 0 ]; then
      printf '%s' "$label did not start on this device within $((HEALTH_WAITED / 60)) minutes"
    else
      printf '%s' "$label did not start on this device within $HEALTH_WAITED seconds"
    fi
  fi
}

# The previous verified export, when there is one to go back to.
_prev_export() {
  [ -n "${_prev_rel:-}" ] && [ "$_prev_rel" != "$_rel_name" ] \
    && [ -d "$STAGE_ROOT/$_prev_rel/." ] || return 1
  printf '%s' "$STAGE_ROOT/$_prev_rel"
}

# Point the current link back at the previous export after a switch back, so
# what the device runs and what the link names agree again.
_current_back() {
  ln -sfn "$_prev_rel" "$STAGE_ROOT/.current.tmp" \
    && mv -T -f "$STAGE_ROOT/.current.tmp" "$STAGE_ROOT/current" \
    || log "WARN: could not point $STAGE_ROOT/current back at $_prev_rel."
}

# Record a switch back in STATE_FILE so Settings can say what happened after
# the page that pressed Update is gone (the app restarts during an update).
# The next update that goes through writes the file afresh without it.
_record_rollback() {
  _merge_state "rollback_reason=$1" "rolled_back_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "rollback_version=${target_ver:-}" ${bootstrapped_at:+"bootstrapped_at=$bootstrapped_at"}
}

_prev_label="${running:-the version it had before}"

# --- Pi Hosted (Docker) deployment -----------------------------------------
# On a Pi Hosted appliance the app runs from a prebuilt image (see
# docker-compose.appliance.yml: only ./data is mounted, the code lives in the
# image), NOT a volume-mounted checkout, so "update" means pulling the new image
# and recreating the service container. The git fast-forward above still matters
# because it refreshes the local build-from-source fallback and the Stream Deck
# package. We detect this layout by the compose project at INSTALL_DIR and exit
# through this branch so the venv path below never runs on a hosted box.
COMPOSE_FILE="$INSTALL_DIR/docker-compose.yml"
if [ -f "$COMPOSE_FILE" ] && command -v docker >/dev/null 2>&1; then
  log "Docker deployment detected at $INSTALL_DIR; updating via Docker."
  if ! cd "$INSTALL_DIR"; then
    _result 0 "Could not enter $INSTALL_DIR to run the Docker update." "$before" "$after" 0 0 0 0 "$recovered"
  fi

  # One-time image migration: the project moved to a GitHub organization, and
  # the published image with it. A compose file deployed before the move still
  # pulls the legacy personal-account package, which no longer receives builds,
  # so rewrite the image reference in place (idempotent: the old string is gone
  # after the first run). NOTE: this runs from the REFRESHED helper, so a device
  # updating from the pre-move version needs two Update presses: the first pull
  # refreshes this script, the second applies the migration and pulls the new
  # image.
  if grep -q "ghcr.io/syracuse3dprinting/foodassistant" "$COMPOSE_FILE" 2>/dev/null; then
    if sed -i "s|ghcr.io/syracuse3dprinting/foodassistant|ghcr.io/syracuse3dprintingorg/pantryraider|g" "$COMPOSE_FILE"; then
      log "Migrated compose image reference to ghcr.io/syracuse3dprintingorg/pantryraider"
    else
      log "WARN: could not rewrite the legacy image reference in $COMPOSE_FILE"
    fi
  fi

  # The compose file is copied in once at first boot and never replaced, so
  # bring an older one up to the current defaults with targeted edits (one
  # uvicorn worker, the Grocy/Mealie/Beszel bind variables). The helper keeps
  # every other line as the owner left it, saves a .bak-<timestamp> copy,
  # checks the result with docker compose config before swapping it in, and
  # changes nothing when there is nothing to do. It never fails the update.
  _migrate_helper=""
  for _m in "$SRC/scripts/image-build/foodassistant-compose-migrate" \
            "$BIN_DIR/foodassistant-compose-migrate"; do
    if [ -f "$_m" ]; then _migrate_helper="$_m"; break; fi
  done
  if [ -n "$_migrate_helper" ]; then
    _mig_recreate="${RUN_TMP:-/tmp}/compose-migrate-recreate"
    : > "$_mig_recreate" 2>/dev/null || true
    if _mig_log="$(REPO_DIR="$REPO" python3 "$_migrate_helper" --env-file "$ENV_FILE" \
        --recreate-file "$_mig_recreate" "$COMPOSE_FILE" 2>&1)"; then
      [ -n "$_mig_log" ] && log "$_mig_log"
    else
      [ -n "$_mig_log" ] && log "$_mig_log"
      log "WARN: could not check $COMPOSE_FILE for older settings; it is unchanged."
    fi
    # A Beszel hub without an admin account moved to this device only; apply
    # that now when it is running, rather than at the next restart of the stack.
    if grep -qx 'beszel' "$_mig_recreate" 2>/dev/null \
        && [ -n "$(docker compose ps -q beszel 2>/dev/null | head -n1)" ]; then
      if _bz_log="$(REPO_DIR="$REPO" docker compose up -d --no-deps beszel 2>&1)"; then
        log "Restarted the Beszel hub so it answers only on this device."
      else
        log "$_bz_log"
        log "WARN: could not restart the Beszel hub; it moves to this device only at its next restart."
      fi
    fi
  fi

  # Keep the pulled image on the same channel as the update. Every release
  # image carries its version tag, and :latest moves only on signed releases,
  # so on the stable channel FOODASSISTANT_TAG in the stack .env is pinned to
  # the release, by digest when its signed record names one (IMAGE_REF above).
  # The value it replaced is saved once to PIN_STATE_FILE and restored when
  # the device returns to the main channel, so an operator's own pin is never
  # lost; a saved 'latest' comes back as 'main', which is what follows the
  # main channel now. Compose files that hardcode their image tag simply
  # ignore the variable, which is harmless.
  ENV_FILE="${ENV_FILE:-$INSTALL_DIR/.env}"
  _set_env_tag() {
    # Set FOODASSISTANT_TAG=$1 in ENV_FILE (replace the line or append it). The
    # new contents are written atomically so a power cut here cannot corrupt the
    # stack .env and leave the compose image reference unreadable on next boot.
    local body
    if [ -f "$ENV_FILE" ] && grep -q '^FOODASSISTANT_TAG=' "$ENV_FILE" 2>/dev/null; then
      body="$(sed "s|^FOODASSISTANT_TAG=.*|FOODASSISTANT_TAG=$1|" "$ENV_FILE")"
      _atomic_write "$ENV_FILE" "$body
"
    elif [ -f "$ENV_FILE" ]; then
      body="$(cat "$ENV_FILE")"
      _atomic_write "$ENV_FILE" "$body
FOODASSISTANT_TAG=$1
"
    else
      _atomic_write "$ENV_FILE" "FOODASSISTANT_TAG=$1
"
    fi
  }
  # Drop the FOODASSISTANT_TAG line (it was not there before this run).
  _clear_env_tag() {
    local body
    [ -f "$ENV_FILE" ] || return 0
    grep -q '^FOODASSISTANT_TAG=' "$ENV_FILE" 2>/dev/null || return 0
    body="$(grep -v '^FOODASSISTANT_TAG=' "$ENV_FILE")"
    if [ -n "$body" ]; then
      _atomic_write "$ENV_FILE" "$body
"
    else
      _atomic_write "$ENV_FILE" ""
    fi
  }
  _had_env_tag=0
  grep -q '^FOODASSISTANT_TAG=' "$ENV_FILE" 2>/dev/null && _had_env_tag=1
  _cur_env_tag="$(grep '^FOODASSISTANT_TAG=' "$ENV_FILE" 2>/dev/null | tail -n1 | cut -d= -f2-)"
  _pin_created=0
  _pin_removed=0
  _pin_saved=""
  if [ "$channel" = "stable" ] && [ -n "$IMAGE_REF" ]; then
    if [ "$_cur_env_tag" != "$IMAGE_REF" ]; then
      if [ ! -f "$PIN_STATE_FILE" ]; then
        if _atomic_write "$PIN_STATE_FILE" "${_cur_env_tag:-latest}
" 2>/dev/null; then
          _pin_created=1
        else
          log "WARN: could not record the previous image tag in $PIN_STATE_FILE"
        fi
      fi
      if _set_env_tag "$IMAGE_REF" 2>/dev/null; then
        log "Pinned the app image to $IMAGE_REF (stable channel)."
      else
        log "WARN: could not pin FOODASSISTANT_TAG in $ENV_FILE; the image stays on $_cur_env_tag."
      fi
    fi
  elif [ "$channel" = "main" ] && [ -f "$PIN_STATE_FILE" ]; then
    _restore_tag="$(head -n1 "$PIN_STATE_FILE" 2>/dev/null | tr -d '[:space:]')"
    case "$_restore_tag" in ""|latest) _restore_tag="main" ;; esac
    if _set_env_tag "$_restore_tag" 2>/dev/null; then
      _pin_saved="$(cat "$PIN_STATE_FILE" 2>/dev/null)"
      _pin_removed=1
      rm -f "$PIN_STATE_FILE" 2>/dev/null || true
      log "Back on the main channel; the app image follows $_restore_tag again."
    else
      log "WARN: could not restore FOODASSISTANT_TAG in $ENV_FILE."
    fi
  elif [ "$channel" = "main" ] && [ -n "$IMAGE_REF" ] && [ "$_cur_env_tag" != "$IMAGE_REF" ]; then
    if _set_env_tag "$IMAGE_REF" 2>/dev/null; then
      log "The app image follows $IMAGE_REF (main channel)."
    else
      log "WARN: could not set FOODASSISTANT_TAG in $ENV_FILE."
    fi
  fi

  # The compose file mounts the Grocy start-up hook from the source checkout
  # (${REPO_DIR}/docker/grocy-init). This script passes REPO_DIR on its own
  # compose calls, but a plain 'docker compose up' (the print setup, or one
  # run by hand) only sees the stack .env, and without REPO_DIR there it falls
  # back to a path that does not exist on installer-provisioned devices and
  # mounts an empty folder. Record where the checkout lives, once.
  if ! grep -q '^REPO_DIR=' "$ENV_FILE" 2>/dev/null; then
    if [ -f "$ENV_FILE" ]; then
      _env_body="$(cat "$ENV_FILE")"
      _atomic_write "$ENV_FILE" "$_env_body
REPO_DIR=$REPO
" 2>/dev/null && _repo_dir_saved=1 || _repo_dir_saved=0
    else
      _atomic_write "$ENV_FILE" "REPO_DIR=$REPO
" 2>/dev/null && _repo_dir_saved=1 || _repo_dir_saved=0
    fi
    if [ "$_repo_dir_saved" = "1" ]; then
      log "Recorded REPO_DIR=$REPO in $ENV_FILE."
    else
      log "WARN: could not record REPO_DIR in $ENV_FILE."
    fi
  fi
  _move_env_repo_dir_off_home "$ENV_FILE"

  img_before="$(docker compose images -q service 2>/dev/null | head -n1)"
  # The image reference the running container was created from, so a switch
  # back can point that reference at the old image again (a moving tag such
  # as main now names the new one).
  _ctr_before="$(docker compose ps -a -q service 2>/dev/null | head -n1)"
  [ -n "$_ctr_before" ] || _ctr_before="$(docker compose ps -q service 2>/dev/null | head -n1)"
  _img_ref_before=""
  if [ -n "$_ctr_before" ]; then
    _img_ref_before="$(docker inspect -f '{{.Config.Image}}' "$_ctr_before" 2>/dev/null | head -n1)"
  fi

  # Prefer the published image. On the main channel a failed pull (offline,
  # or no image for this commit yet) falls back to building from the verified
  # export; the build context resolves through REPO_DIR (see the compose
  # file). The stable channel never builds.
  # Pull the new image FULLY before touching the running container. Docker
  # writes the new image into its content-addressed store and only moves the tag
  # reference once every layer is present, so a power cut mid-pull leaves the OLD
  # image intact and the running stack untouched: never a half-updated state.
  built_from_source=0
  if pull_log="$(docker compose pull service 2>&1)"; then
    log "$pull_log"
    # Flush the freshly pulled image to the card before we recreate the
    # container, so the new image survives a power loss during the swap.
    _sync
  elif [ "$channel" = "stable" ]; then
    # A release is installed from its published image only: a local build
    # outlasts the bridge's time limit on a Pi and would come back every few
    # hours. Put the image tag back so a reboot starts the image this device
    # already has, and try again on the next run.
    log "Image pull failed:"
    log "$pull_log"
    if [ "$_had_env_tag" = "1" ]; then
      _set_env_tag "$_cur_env_tag" 2>/dev/null \
        || log "WARN: could not put FOODASSISTANT_TAG back in $ENV_FILE."
    else
      _clear_env_tag 2>/dev/null \
        || log "WARN: could not put FOODASSISTANT_TAG back in $ENV_FILE."
    fi
    if [ "$_pin_created" = "1" ]; then
      rm -f "$PIN_STATE_FILE" 2>/dev/null || true
    fi
    R_HOLD="The app image for ${target_ver:-this release} is not available yet; this device stays on $running_label and will try again."
    _result 0 "$R_HOLD" "$before" "$after" 0 0 0 0 "$recovered"
  else
    log "Image pull failed; building from the verified source instead:"
    log "$pull_log"
    if build_log="$(REPO_DIR="$SRC" docker compose build service 2>&1)"; then
      log "$build_log"
      built_from_source=1
    else
      log "$build_log"
      _result 0 "Image pull and local build both failed; the running version is unchanged." "$before" "$after" 0 0 0 0 "$recovered"
    fi
  fi

  # Recreate only the service container so Grocy and Mealie keep running.
  if up_log="$(REPO_DIR="$REPO" docker compose up -d --no-deps service 2>&1)"; then
    log "$up_log"
  elif printf '%s' "$up_log" | grep -qi "already in use\|name.*is already in use\|Conflict"; then
    # A recreate can deadlock when a previous interrupted run left the old
    # container renamed (e.g. <hash>_foodassistant-service) still holding the
    # name. Docker then refuses to give the new container that name. Clean up
    # the conflicting containers and retry once with a forced recreate.
    log "$up_log"
    log "Name conflict on recreate; removing the leftover container(s) and retrying."
    docker rm -f foodassistant-service >/dev/null 2>&1 || true
    for _c in $(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E '_foodassistant-service$'); do
      log "Removing stale container $_c"
      docker rm -f "$_c" >/dev/null 2>&1 || true
    done
    if up_log="$(REPO_DIR="$REPO" docker compose up -d --no-deps --force-recreate service 2>&1)"; then
      log "$up_log"
      recovered=1
    else
      log "$up_log"
      _result 0 "Could not recreate the service container; the running version may be unchanged." "$before" "$after" 0 0 0 0 "$recovered"
    fi
  else
    log "$up_log"
    _result 0 "Could not recreate the service container; the running version may be unchanged." "$before" "$after" 0 0 0 0 "$recovered"
  fi

  # The container was recreated on the already-local new image (atomic swap:
  # compose stops the old one and starts the new one, and restart:unless-stopped
  # brings it back after a reboot). Flush the new state to the card.
  _sync
  img_after="$(docker compose images -q service 2>/dev/null | head -n1)"

  # Wait for the new container to answer. Only a release pinned by the stable
  # channel is held to its version: a main-channel image is built on its own
  # schedule and can carry a slightly different version than the commit
  # checked here. The container was recreated, so whatever answers is it.
  _docker_rolled_back=0
  _docker_rollback_failed=""
  if [ "$HEALTH_TIMEOUT" != "0" ] && { [ "$built_from_source" = "1" ] \
      || { [ -n "$img_after" ] && [ "$img_before" != "$img_after" ]; }; }; then
    _want=""
    [ "$channel" = "stable" ] && _want="$target_ver"
    _w="$(_wait_for "$HEALTH_TIMEOUT" $((HEALTH_ROLLBACK_TIMEOUT + 60)) 60)"
    log "Waiting up to $_w seconds for the new version to answer at $(_health_url docker)..."
    if _wait_healthy "$(_health_url docker)" "$_w" "$_want"; then
      log "The new version is up (${HEALTH_SEEN:-version not reported})."
    else
      _why="$(_not_started_why "$_want")"
      log "$_why."
      if [ -z "$img_before" ]; then
        _docker_rollback_failed="$_why, and there is no earlier version on this device to go back to. Restart the device, then try the update again."
      else
        log "Going back to $_prev_label."
        # The stack .env exactly as it was before this run.
        if [ "$_had_env_tag" = "1" ]; then
          _set_env_tag "$_cur_env_tag" 2>/dev/null \
            || log "WARN: could not put FOODASSISTANT_TAG back in $ENV_FILE."
        else
          _clear_env_tag 2>/dev/null \
            || log "WARN: could not put FOODASSISTANT_TAG back in $ENV_FILE."
        fi
        if [ "$_pin_created" = "1" ]; then
          rm -f "$PIN_STATE_FILE" 2>/dev/null || true
        fi
        if [ "$_pin_removed" = "1" ] && [ -n "$_pin_saved" ]; then
          _atomic_write "$PIN_STATE_FILE" "$_pin_saved
" 2>/dev/null || log "WARN: could not put $PIN_STATE_FILE back."
        fi
        # A digest reference already names the old image; any other one is
        # pointed back at it.
        case "$_img_ref_before" in
          ""|*@*) ;;
          *) docker tag "$img_before" "$_img_ref_before" >/dev/null 2>&1 \
               || log "WARN: could not point $_img_ref_before back at the previous image." ;;
        esac
        _rb_ok=0
        if up_log="$(REPO_DIR="$REPO" docker compose up -d --no-deps --force-recreate service 2>&1)"; then
          log "$up_log"
          _sync
          img_after="$(docker compose images -q service 2>/dev/null | head -n1)"
          if [ "$img_after" = "$img_before" ]; then
            _w="$(_wait_for "$HEALTH_ROLLBACK_TIMEOUT" 10 30)"
            log "Waiting up to $_w seconds for $_prev_label to answer..."
            if _wait_healthy "$(_health_url docker)" "$_w" "${running:-}"; then
              _rb_ok=1
            else
              log "$_prev_label did not answer either."
            fi
          else
            log "The previous image did not come back (now $(_short_image_id "$img_after"))."
          fi
        else
          log "$up_log"
        fi
        if [ "$_rb_ok" = "1" ]; then
          _docker_rolled_back=1
          R_HOLD="$_why, so it went back to $_prev_label. It tries again when a newer version comes out, or when you press Update now."
          log "$R_HOLD"
          # The host packages below follow the version that runs.
          if _psrc="$(_prev_export)"; then
            SRC="$_psrc"
            _current_back
          fi
        else
          _docker_rollback_failed="$_why, and going back to $_prev_label did not work either. Restart the device; if Pantry Raider still does not open, the update log is at /var/log/foodassistant-update.log."
        fi
      fi
    fi
  fi
  if [ -n "$_docker_rollback_failed" ]; then
    R_HOLD="$_docker_rollback_failed"
    log "$R_HOLD"
    _record_rollback "$R_HOLD"
    _result 0 "$R_HOLD" "$before" "$after" 1 1 0 0 "$recovered"
  fi

  # Grocy config self-heal: a Grocy image update can leave config.php naming
  # a class that moved (the AUTH_CLASS namespace change in Grocy 4.7), after
  # which Grocy answers every request with an error page and the inventory
  # stops loading. The helper checks the running container and rewrites that
  # one line, with a backup, only when the new class exists there; anything
  # else is a logged no-op. The stack's Grocy container also carries the same
  # repair as a start-up hook (docker/grocy-init), but a container started
  # before that mount existed never sees it, so the running one is checked
  # here on every update. Best effort: an update never fails because of it.
  if [ -x "$BIN_DIR/foodassistant-grocy-repair" ]; then
    if _grout="$(INSTALL_DIR="$INSTALL_DIR" "$BIN_DIR/foodassistant-grocy-repair" 2>&1)"; then
      log "Grocy config check: $(printf '%s\n' "$_grout" | grep '^\[grocy-repair\]' | tail -n1)"
    else
      log "WARN: Grocy config check did not complete: $(printf '%s\n' "$_grout" | grep '^\[grocy-repair\]' | tail -n1)"
    fi
  fi

  # The Stream Deck package lives on the host as its own systemd unit, so the
  # Docker app update above never touches it. Sync and restart it here or a
  # pi_hosted device never receives deck code changes (FoodAssistant-aus1).
  sync_streamdeck
  if [ "$sd_synced" = "1" ]; then _restart_unit "$SD_SERVICE" && restarted=1; fi
  sync_gadgets
  if [ "$gd_synced" = "1" ]; then _restart_unit "$GD_SERVICE" && restarted=1; fi

  # Reload the on-screen kiosk so the new UI shows (absent on headless boxes).
  # Last, so the kiosk launcher starts against the deck package just synced.
  _restart_unit "$KIOSK_SERVICE" && restarted=1

  changed=0
  if [ "$built_from_source" = "1" ]; then changed=1; fi
  if [ -n "$img_after" ] && [ "$img_before" != "$img_after" ]; then changed=1; fi
  _img_before_short="$(_short_image_id "$img_before")"
  _img_after_short="$(_short_image_id "$img_after")"
  if [ "$_docker_rolled_back" = "1" ]; then
    _record_rollback "$R_HOLD"
    _result 0 "$R_HOLD" "$before" "$before" 1 0 "$sd_synced" 0 "$recovered"
  fi
  _write_state
  if [ "$changed" = "1" ]; then
    log "Service image refreshed (${_img_before_short:-none} -> ${_img_after_short:-unknown}, streamdeck=$sd_synced)."
    _result 1 "" "$before" "$after" "$restarted" 1 "$sd_synced" 0 "$recovered"
  else
    log "Service image already up to date (${_img_after_short:-unknown}, streamdeck=$sd_synced)."
    _result 1 "" "$before" "$after" "$restarted" 0 "$sd_synced" 0 "$recovered"
  fi
fi

# --- Web app service --------------------------------------------------------
svc_src="$SRC/service"
if [ -d "$svc_src" ]; then
  # Reinstall venv deps only when the deployed requirements differ from the
  # source (covers both a first deploy and any requirements.txt change). We
  # compare the DEPLOYED copy rather than the pre/post-pull commit so a manual
  # pull still installs when needed and a no-op run stays fast.
  src_req="$svc_src/requirements.txt"
  dst_req="$APP_DIR/requirements.txt"
  need_pip=0
  if [ -f "$src_req" ]; then
    if [ ! -f "$dst_req" ]; then
      need_pip=1
    else
      sa="$(sha1sum "$src_req" 2>/dev/null | cut -d' ' -f1)"
      da="$(sha1sum "$dst_req" 2>/dev/null | cut -d' ' -f1)"
      [ "$sa" != "$da" ] && need_pip=1
    fi
  fi
  if [ "$need_pip" = "1" ] && [ -x "$VENV_DIR/bin/pip" ]; then
    log "requirements changed; installing into venv at $VENV_DIR"
    if "$VENV_DIR/bin/pip" install --quiet -r "$src_req"; then
      deps=1
    else
      log "pip install failed; leaving the running version in place."
      _result 0 "Dependency install failed; the old version is still running." "$before" "$after" 0 0 0 0 "$recovered"
    fi
  else
    log "requirements unchanged; skipping pip install."
  fi

  # Refresh the deployed app copy (the service runs from APP_DIR, separate from
  # the git checkout so a pull never half-swaps files under a running process).
  if [ -d "$APP_DIR" ]; then
    log "Syncing service app into $APP_DIR"
    if cp -a "$svc_src/." "$APP_DIR/"; then
      svc_synced=1
    else
      log "WARN: could not sync $APP_DIR"
    fi
  else
    log "App dir $APP_DIR does not exist; skipping service sync."
  fi
else
  log "No service/ in the checkout; skipping app sync."
fi

# --- Stream Deck controller -------------------------------------------------
sync_streamdeck

# --- Bluetooth thermometer reader ---------------------------------------------
sync_gadgets

# --- Restart the services we actually refreshed -----------------------------
_venv_rolled_back=0
if [ "$svc_synced" = "1" ] || [ "$deps" = "1" ]; then
  _app_restarted=0
  if _restart_unit "$SERVICE"; then
    restarted=1
    _app_restarted=1
  elif systemctl list-unit-files "$SERVICE" >/dev/null 2>&1; then
    # Installed, but the restart failed: what runs now is unknown, so check.
    _app_restarted=1
  fi
  # Wait for the restarted app to answer as the version just deployed (it
  # runs from APP_DIR, which now holds exactly that version).
  if [ "$_app_restarted" = "1" ] && [ "$HEALTH_TIMEOUT" != "0" ]; then
    _w="$(_wait_for "$HEALTH_TIMEOUT" $((HEALTH_ROLLBACK_TIMEOUT + 60)) 60)"
    log "Waiting up to $_w seconds for the new version to answer at $(_health_url venv)..."
    if _wait_healthy "$(_health_url venv)" "$_w" "${target_ver:-}"; then
      log "The new version is up (${HEALTH_SEEN:-version not reported})."
    else
      _why="$(_not_started_why "${target_ver:-}")"
      log "$_why."
      if ! _psrc="$(_prev_export)"; then
        R_HOLD="$_why. Restart the device, then try the update again."
        log "$R_HOLD"
        _record_rollback "$R_HOLD"
        _result 0 "$R_HOLD" "$before" "$after" "$restarted" "$svc_synced" "$sd_synced" "$deps" "$recovered"
      fi
      log "Going back to $_prev_label from $_psrc."
      SRC="$_psrc"
      _current_back
      if [ "$deps" = "1" ] && [ -f "$SRC/service/requirements.txt" ] && [ -x "$VENV_DIR/bin/pip" ]; then
        # Put the dependencies the previous version ran with back, within what
        # is left of the run's time.
        _pt=$(( $(_budget_left) - HEALTH_ROLLBACK_TIMEOUT - 30 ))
        [ "$_pt" -lt 60 ] && _pt=60
        log "Reinstalling the previous version's dependencies."
        timeout "$_pt" "$VENV_DIR/bin/pip" install --quiet -r "$SRC/service/requirements.txt" \
          || log "WARN: the previous version's dependencies did not reinstall completely."
      fi
      _rb_ok=0
      if [ -d "$SRC/service" ] && cp -a "$SRC/service/." "$APP_DIR/"; then
        sync_streamdeck
        sync_gadgets
        if _restart_unit "$SERVICE"; then
          _w="$(_wait_for "$HEALTH_ROLLBACK_TIMEOUT" 10 30)"
          log "Waiting up to $_w seconds for $_prev_label to answer..."
          if _wait_healthy "$(_health_url venv)" "$_w" "${running:-}"; then
            _rb_ok=1
          else
            log "$_prev_label did not answer either."
          fi
        fi
      else
        log "WARN: could not copy the previous version back into $APP_DIR."
      fi
      if [ "$_rb_ok" = "1" ]; then
        _venv_rolled_back=1
        R_HOLD="$_why, so it went back to $_prev_label. It tries again when a newer version comes out, or when you press Update now."
        log "$R_HOLD"
      else
        R_HOLD="$_why, and going back to $_prev_label did not work either. Restart the device; if Pantry Raider still does not open, the update log is at /var/log/foodassistant-update.log."
        log "$R_HOLD"
        _record_rollback "$R_HOLD"
        _result 0 "$R_HOLD" "$before" "$after" "$restarted" "$svc_synced" "$sd_synced" "$deps" "$recovered"
      fi
    fi
  fi
fi
if [ "$sd_synced" = "1" ]; then
  _restart_unit "$SD_SERVICE" && restarted=1
fi
if [ "$gd_synced" = "1" ]; then
  _restart_unit "$GD_SERVICE" && restarted=1
fi
# Reload the on-screen kiosk so the new app code actually shows. The browser
# would otherwise keep serving the page it loaded before the deploy. It also
# restarts when its launch settings changed above, even with no new app code,
# and it goes last so it starts against the deck package just synced.
if [ "$svc_synced" = "1" ] || [ "$KIOSK_UNIT_CHANGED" = "1" ]; then
  _restart_unit "$KIOSK_SERVICE" && restarted=1
fi

if [ "$svc_synced" = "0" ] && [ "$sd_synced" = "0" ]; then
  log "Nothing to deploy (no service or Stream Deck source found)."
  _result 0 "Nothing to deploy; no app or Stream Deck source found on this device." "$before" "$after" "$restarted" "$svc_synced" "$sd_synced" "$deps" "$recovered"
fi

if [ "$_venv_rolled_back" = "1" ]; then
  _record_rollback "$R_HOLD"
  _result 0 "$R_HOLD" "$before" "$before" "$restarted" "$svc_synced" "$sd_synced" "$deps" "$recovered"
fi

log "Update complete (service=$svc_synced streamdeck=$sd_synced deps=$deps restarted=$restarted)."
_write_state
_result 1 "" "$before" "$after" "$restarted" "$svc_synced" "$sd_synced" "$deps" "$recovered"
