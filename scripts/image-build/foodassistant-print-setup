# Used for BT discovery (is_matching_bt_name) and family detection. The brand
# names "supvan" and "katasymbol" are always accepted. The "t0117" and "t0148"
# entries are device serial-name prefixes: some units advertise a bare serial
# (e.g. a T50M Pro as "T0148C260429G993") instead of a friendly name, so their
# prefix must be listed here or the bridge never auto-adds them. Add new serial
# prefixes here as other Supvan models are seen in the field.
[bt_patterns]
supvan_t50 = ["t50", "t0117", "t0148", "e10", "e11", "e12", "e16"]
supvan_t80 = ["t80"]
supvan_g = ["g11", "g15", "g18"]
supvan_tp76 = ["tp76"]
supvan_tp80 = ["tp80"]
supvan_tp86 = ["tp86"]
supvan_sp650 = ["sp650"]
MODELS_EOF
  log "Wrote Supvan model registry override ($SUPVAN_MODELS_FILE)."
}

# The address the bridge listens on (FoodAssistant-9yuwu). The bridge serves its
# status page and IPP on one listener with no access control of its own, so it
# cannot keep the page local while printing stays on the network. The default,
# every interface, is what fleet printing needs today: the main server reads a
# Bandit's bridge page to find its printers and prints to ipp://<bandit>:8631.
# A device that never prints for the fleet can set SUPVAN_HOST=127.0.0.1 in the
# environment or in the stack .env (kept across updates) to answer only itself.
supvan_bind_host() {
  local host="${SUPVAN_HOST:-}"
  if [ -z "$host" ] && [ -f "$ENV_FILE" ]; then
    host="$(sed -n 's/^SUPVAN_HOST=//p' "$ENV_FILE" 2>/dev/null | tail -n1 | tr -d '[:space:]')"
  fi
  [ -n "$host" ] || host="0.0.0.0"
  # A plain pattern match, not grep: grep tests each line on its own, so a
  # value with an embedded newline could pass and inject a unit line.
  if [ "$host" != "localhost" ] && [[ "$host" == *[!0-9A-Fa-f:.]* ]]; then
    warn "SUPVAN_HOST '$host' is not an address; the Supvan bridge listens on every interface."
    host="0.0.0.0"
  fi
  printf '%s\n' "$host"
}

# Install and start the systemd unit that runs the printer application. The app
# serves IPP on port 8631 (on the address supvan_bind_host picks) and
# advertises over DNS-SD; it needs bluez (for RFCOMM) and the system D-Bus.
write_supvan_unit() {
  command -v systemctl >/dev/null 2>&1 || { warn "systemctl not found; not installing the Supvan service."; return 0; }
  # Always refresh the model-registry override alongside the unit, so an
  # existing install picks up new serial prefixes on the next setup run.
  write_supvan_models
  local unit_name bind_host
  unit_name="$(basename "$SUPVAN_UNIT")"
  bind_host="$(supvan_bind_host)"
  mkdir -p "$(dirname "$SUPVAN_UNIT")" 2>/dev/null || true
  cat > "$SUPVAN_UNIT" <<EOF
[Unit]
Description=FoodAssistant Supvan label printer bridge (IPP Everywhere over Bluetooth)
Documentation=https://github.com/heeen/supvan-cups
After=network-online.target bluetooth.service dbus.service
Wants=network-online.target bluetooth.service

[Service]
Type=simple
Environment=SUPVAN_MODELS=$SUPVAN_MODELS_FILE
Environment=SUPVAN_HOST=$bind_host
# Ensure the radio is usable before the bridge opens RFCOMM: a reboot can leave
# the adapter rfkill-blocked or the HCI interface DOWN, which makes the bridge
# start with no reachable printer (FoodAssistant-h2j6). Best-effort, so a host
# without these tools or an already-up radio is unaffected.
ExecStartPre=-/bin/sh -c 'command -v rfkill >/dev/null 2>&1 && rfkill unblock bluetooth; command -v hciconfig >/dev/null 2>&1 && hciconfig hci0 up; command -v bluetoothctl >/dev/null 2>&1 && bluetoothctl power on; true'
ExecStart=$SUPVAN_BIN
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now "$unit_name" >/dev/null 2>&1 \
    && log "Enabled and started the Supvan bridge service (IPP on $bind_host:8631)." \
    || warn "Could not enable/start the Supvan bridge service."
}

# Bluetooth (Supvan) printing is opt-in (FoodAssistant-po9c). It is enabled by
# ENABLE_BLUETOOTH_PRINTING=1 in the environment, or by a BLUETOOTH_PRINTING=1
# marker the app writes into the stack .env when a user turns it on, so an OTA
# re-assert keeps the bridge without the env being set. Default off keeps the
# base print install (CUPS + network discovery) fast: no Rust build.
bluetooth_printing_enabled() {
  case "${ENABLE_BLUETOOTH_PRINTING:-0}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
  esac
  if [ -f "$ENV_FILE" ] && grep -qiE '^BLUETOOTH_PRINTING=(1|true|yes|on)([[:space:]]|$)' "$ENV_FILE" 2>/dev/null; then
    return 0
  fi
  return 1
}

install_supvan_bridge() {
  # The Supvan bridge speaks RFCOMM to the printer, so the radio must be up. On
  # a fresh Pi the adapter is often blocked/DOWN (Dan's Bandit); ensure it is
  # usable before we depend on it. Best-effort and idempotent.
  bluetooth_adapter_up
  # Already installed for this release? Re-assert the unit and stop.
  if [ -x "$SUPVAN_BIN" ] && [ "$(supvan_installed_version)" = "$SUPVAN_BRIDGE_RELEASE" ]; then
    log "Supvan bridge: $SUPVAN_BRIDGE_RELEASE already installed at $SUPVAN_BIN; skipping install."
    write_supvan_unit
    return 0
  fi
  mkdir -p "$SUPVAN_BIN_DIR" 2>/dev/null || true
  local path=""
  if install_supvan_prebuilt; then
    path="prebuilt"
  elif install_supvan_from_source; then
    path="source"
  fi
  if [ -z "$path" ]; then
    warn "Supvan bridge: neither the prebuilt nor the source install succeeded; the T50M bridge is not available. The rest of the print stack is unaffected."
    return 0
  fi
  printf '%s\n' "$SUPVAN_BRIDGE_RELEASE" > "$SUPVAN_VERSION_FILE" 2>/dev/null || true
  log "Supvan bridge: installed via the ${path} path -> $SUPVAN_BIN ($SUPVAN_BRIDGE_RELEASE)."
  # bluez must be live for RFCOMM; enable_services handles it earlier, re-assert.
  command -v systemctl >/dev/null 2>&1 && systemctl enable --now bluetooth >/dev/null 2>&1 || true
  write_supvan_unit
  return 0
}

