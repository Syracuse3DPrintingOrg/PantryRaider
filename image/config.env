# Pantry Raider appliance configuration (OPTIONAL)
# ================================================
# You do NOT need to touch this file. A device with no config file at all boots
# into a working Pantry Raider + Grocy appliance at http://foodassistant.local:9284/,
# auto-enables the kiosk when a display is attached and the Stream Deck when one
# is plugged in, and takes its timezone from the OS (set by Raspberry Pi Imager).
#
# This file only exists for overrides. Uncomment and change a line to force a
# value. It is read once by the first-boot provisioner (firstboot.sh), and may
# be edited on the SD card's boot partition after flashing if you want to.
#
# Format: KEY=value  (POSIX shell assignment: no spaces around '=', quote
# values that contain spaces). Lines starting with '#' are comments.

# ── Identity / network ─────────────────────────────────────────────────────
# Hostname for the box, also the mDNS name (<HOSTNAME>.local).
# HOSTNAME=foodassistant

# Timezone (IANA name). Default: taken from the OS (Imager's setting).
# TZ=America/New_York

# Recovery hotspot. When the device cannot reach any network it broadcasts
# its own Wi-Fi so you can connect and fix things. The network name defaults
# to FoodAssistant and the password is generated uniquely for your device
# (you will find it in pantry-raider-hotspot.txt on this boot partition).
# Pre-seed your own here if you prefer; both can also be changed later in
# Settings, Network. Name: 1 to 32 characters. Password: 8 to 63 characters.
# AP_SSID=FoodAssistant
# AP_PASSPHRASE=

# ── Deployment mode ────────────────────────────────────────────────────────
# How this device is used. Leave unset for the default all-in-one Pi (installs
# Pantry Raider + Grocy locally). Set "pi_remote" to make this box a thin
# control surface only: it installs NO Docker/Grocy/Mealie and instead points
# its kiosk and/or Stream Deck at a Pantry Raider server already running
# elsewhere on your LAN. That keeps it light enough for a Pi 3.
#   DEPLOYMENT_MODE=pi_remote
#   REMOTE_SERVER_URL=http://192.168.1.50:9284
# (Normally you pick this in the setup wizard; pre-seed it here for a Pi Remote,
# which has no local app to choose it from.)
# DEPLOYMENT_MODE=
# REMOTE_SERVER_URL=

# ── Backends (Docker Compose profiles) ─────────────────────────────────────
# Grocy (inventory) is the core backend and is always enabled. Recipes, the
# meal plan, and the shopping list are built into Pantry Raider, so nothing
# else is required. Mealie is optional, for people who already use it: set
# ENABLE_MEALIE=true to install it alongside. Ollama (local AI) is off by
# default; set ENABLE_OLLAMA=true to install it.
# ENABLE_MEALIE=false
# ENABLE_OLLAMA=false

# ── Kiosk mode ─────────────────────────────────────────────────────────────
# Default "auto": the kiosk launches whenever a display is detected, and is
# skipped on a headless box. A display connected later still gets a kiosk:
# the device notices it and sets the kiosk up on its own. Force with
# "true" (install even headless) or "false" (never, not even automatically).
# ENABLE_KIOSK=auto

# Display rotation applied at the KMS/DRM layer (rotates boot console and
# kiosk). Valid values: 0, 90, 180, 270 (degrees clockwise). Requires a reboot
# to take effect; the provisioner's first-boot reboot handles this automatically.
# DISPLAY_ROTATION=0

# URL the kiosk opens. ?kiosk=1 enables the attached-display scale/orientation
# settings. Change only if you front the app with a reverse proxy.
# KIOSK_URL=http://localhost:9284/ui/?kiosk=1

# Boot splash. A kiosk device paints the Pantry Raider mark to the screen
# moments after power-on instead of showing boot text, and hands the display
# to the app when it is ready. Set "false" to keep the plain quiet boot.
# ENABLE_FB_SPLASH=true

# ── Stream Deck controller ─────────────────────────────────────────────────
# Default "auto": the controller installs when an Elgato Stream Deck is plugged
# in at first boot, and is skipped otherwise. Force with "true"/"false".
# ENABLE_STREAMDECK=auto

# ── Sensors and plug-in accessories ────────────────────────────────────────
# The on-device reader for Bluetooth kitchen sensors (probe thermometers,
# fridge hygrometers, door sensors, shelf buttons) and plug-in STEMMA QT
# accessories like the NeoKey scan-mode pad. Default "auto": the reader
# installs when a plug-in accessory is connected at first boot, and is skipped
# otherwise; it can always be added later with one click in Settings,
# Thermometers & Sensors. Force with "true" (install even with nothing
# plugged in) or "false" (never install automatically).
# ENABLE_GADGETS=auto

# ── Image / registry ───────────────────────────────────────────────────────
# Pin a specific Pantry Raider image tag (default: latest).
# FOODASSISTANT_TAG=latest

# Where the stack is installed on the device.
# INSTALL_DIR=/opt/foodassistant
