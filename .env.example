# Pantry Raider: environment variables
#
# The web setup wizard at http://localhost:9284/setup writes to
# service/data/settings.json and is the recommended way to configure
# the app.  Variables set here take priority over the wizard's values,
# making this file useful for CI, scripted deploys, or overrides.
#
# Copy to .env and fill in any values you want to pin via env var:
#   cp .env.example .env

# ── Vision Provider ────────────────────────────────────────────────────────────
# "gemini" (default), "openai", "anthropic" (cloud) or "ollama" (local).
# Leave this blank to pick your provider on the setup page. A value here wins
# over that choice on every restart.
VISION_PROVIDER=

# Gemini: get a free key at aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI: platform.openai.com → API keys (model must be vision-capable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Anthropic: console.anthropic.com → API Keys
# claude-opus-5-5 is the most capable; claude-haiku-5-5 the budget option.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Ollama: start it with  docker compose --profile with-ollama up -d
# then: docker exec foodassistant-ollama ollama pull gemma4:e4b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e4b

# ── Barcode Scan Enrichment ────────────────────────────────────────────────────
# Scanned barcodes are looked up in Open Food Facts, whose names/categories are
# contributor-entered and often messy ("zero sugar" for Dr Pepper Zero). With
# BARCODE_ENRICHMENT=llm the LLM cleans up the name, category, storage location,
# and shelf-life estimate per scan (one small text call). Set to "off" to use
# Open Food Facts heuristics only.
BARCODE_ENRICHMENT=llm
# Provider used for enrichment: "gemini", "openai", "anthropic", "ollama", or
# empty to follow VISION_PROVIDER. For a fully local pipeline set
# VISION_PROVIDER=ollama (or just this to "ollama" to keep a cloud provider
# for photos but enrich locally).
ENRICH_PROVIDER=
# Model override for enrichment; empty uses the chosen provider's model above.
# Enrichment is text-only, so a small/cheap model works well
# (e.g. claude-haiku-5-5, gpt-6-luna, gemma4:e2b).
ENRICH_MODEL=

# ── Grocy ──────────────────────────────────────────────────────────────────────
# URL of your Grocy instance (no trailing slash).
# Use the web setup wizard to configure this interactively.
GROCY_BASE_URL=
GROCY_API_KEY=

# ── Mealie (optional) ──────────────────────────────────────────────────────────
# Recipe manager / meal planner / shopping lists. Enables the Meal Plan and
# Shopping pages plus inventory-aware recipe suggestions.
# Run one with: docker compose --profile with-mealie up -d  (port 9285)
# Use a URL your browser can also reach: recipe links open it directly.
# Token: Mealie → User Profile → API Tokens
MEALIE_BASE_URL=
MEALIE_API_KEY=
# Optional external address used only for browser links (e.g. behind a reverse
# proxy). API calls always use MEALIE_BASE_URL. Empty = links use base URL too.
MEALIE_PUBLIC_URL=

# ── External Recipe Suggestions ────────────────────────────────────────────────
# Source for web recipe ideas on the Cook page: themealdb | spoonacular | off.
# TheMealDB public key "1" is free; a premium supporter key or a Spoonacular
# key unlocks bigger catalogs (Spoonacular free tier ~150 points/day).
RECIPE_SOURCE=themealdb
THEMEALDB_API_KEY=1
SPOONACULAR_API_KEY=

# ── Suggestion Tuning ──────────────────────────────────────────────────────────
# Pantry items assumed on hand (comma-separated; empty = built-in list).
STAPLE_ITEMS=
PERISHABLE_DAYS=14
EXPIRING_SOON_DAYS=5
SUGGEST_PER_TIER=8

# ── Service ────────────────────────────────────────────────────────────────────
# Auto-generated on first run if left empty: you normally don't need to set this.
SECRET_KEY=
DATA_DIR=/app/data

# ── Auth ───────────────────────────────────────────────────────────────────────
# AUTH_REQUIRED: keep true. A kitchen without a password answers only devices
# on your home network. To use it through a reverse proxy or tunnel, set a
# password and turn on two-factor sign-in in Settings, Security: signing in
# from outside your home network needs both. Set false only if everyone on
# your home network may use and change it.
AUTH_REQUIRED=true
# AUTH_PASSWORD: the password for the web interface. Leave it blank to choose
# one during setup. If you ever lose access, set a new one here and restart the
# container with docker compose up -d (a plain restart keeps the old value).
# Signing in through a reverse proxy or tunnel also needs
# two-factor: if it is not on yet, sign in once with the setup code from the
# container log, then turn it on in Settings, Security.
AUTH_PASSWORD=
# API_KEY lets headless clients (Home Assistant, scripts) authenticate
# by sending an X-API-Key header.
#   Generate a key: openssl rand -hex 24
API_KEY=

# ── Which network can reach the bundled services ───────────────────────────────
# The address each bundled web page listens on. 0.0.0.0 is your whole network,
# 127.0.0.1 is this machine only. Grocy and Mealie are open to your network so
# you can use their own pages. On a server that networks you do not trust can
# reach, set both to 127.0.0.1. The Beszel dashboard starts out on this machine
# only, because whoever opens it first creates its admin account; set
# BESZEL_BIND=0.0.0.0 once you have created that account.
# GROCY_BIND=0.0.0.0
# MEALIE_BIND=0.0.0.0
# BESZEL_BIND=127.0.0.1

# ── Timezone ───────────────────────────────────────────────────────────────────
# IANA timezone name, e.g. America/Chicago, Europe/London, Asia/Tokyo.
# Used by all containers. Defaults to America/New_York if not set.
TZ=America/New_York
